+/* T153 has a separate reset-output selection register. Older variants do
+ * not have it, so leave their register programming unchanged.
+ */
+static void sunxi_wdt_set_output(struct sunxi_wdt_dev *sunxi_wdt)
+{
+	const struct sunxi_wdt_reg *regs = sunxi_wdt->wdt_regs;
+	u32 val;
+
+	if (!regs->wdt_out_mask)
+		return;
+
+	val = readl(sunxi_wdt->wdt_base + regs->wdt_out_cfg);
+	val &= ~regs->wdt_out_mask;
+	val |= regs->wdt_out_val | regs->wdt_key_val;
+	writel(val, sunxi_wdt->wdt_base + regs->wdt_out_cfg);
+}
