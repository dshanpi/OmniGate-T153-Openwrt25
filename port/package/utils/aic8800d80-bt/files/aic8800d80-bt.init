#!/bin/sh /etc/rc.common
# SPDX-License-Identifier: GPL-2.0-or-later
START=85
STOP=15
USE_PROCD=1

start_service() {
	local enabled device address rfkill node count
	config_load aic8800d80-bt
	config_get_bool enabled main enabled 1
	[ "$enabled" = 1 ] || return 0
	config_get device main device /dev/ttyS7
	config_get address main address auto
	# FDRV holds the shared WLAN/BT power reference and loads the BT patch by SDIO.
	modprobe aic8800_fdrv || return 1
	modprobe hci_uart || return 1
	modprobe rfkill_gpio || return 1
	count=0
	while [ "$count" -lt 20 ]; do
		rfkill=
		for node in /sys/class/rfkill/rfkill*; do
			[ -f "$node/name" ] || continue
			[ "$(cat "$node/name")" = "t153-aic8800d80-bt" ] || continue
			[ "$(cat "$node/type")" = "bluetooth" ] || continue
			rfkill="$node/soft"
			break
		done
		[ -c "$device" ] && [ -n "$rfkill" ] && [ -d /sys/module/aic8800_fdrv ] && break
		count=$((count + 1))
		sleep 1
	done
	if [ ! -c "$device" ] || [ -z "$rfkill" ] || [ ! -d /sys/module/aic8800_fdrv ]; then
		logger -t aic8800d80-bt "UART7, named Bluetooth rfkill, or shared SDIO firmware loader unavailable"
		return 1
	fi
	procd_open_instance
	procd_set_param command /usr/sbin/aic8800d80-bt --device "$device" --rfkill-soft "$rfkill" --address "$address"
	# Stop retrying after five rapid failures; preserve the evidence in logread.
	procd_set_param respawn 3600 5 5
	procd_set_param term_timeout 5
	procd_set_param stdout 1
	procd_set_param stderr 1
	procd_close_instance
}

service_triggers() {
	procd_add_reload_trigger aic8800d80-bt
}
