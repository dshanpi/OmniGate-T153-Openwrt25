+	struct blob_attr *tb[__REBOOT_MAX] = { 0 };
+	struct blob_attr *cur;
+	const char *command = NULL;
+	int rem;
+
+	if (msg) {
+		/* A mistyped command must not silently turn into an ordinary reboot. */
+		blobmsg_for_each_attr(cur, msg, rem) {
+			if (!strcmp(blobmsg_name(cur), "command") &&
+			    blobmsg_type(cur) != BLOBMSG_TYPE_STRING)
+				return UBUS_STATUS_INVALID_ARGUMENT;
+		}
+		if (blobmsg_parse(reboot_policy, __REBOOT_MAX, tb, blob_data(msg), blob_len(msg)))
+			return UBUS_STATUS_INVALID_ARGUMENT;
+		if (tb[REBOOT_COMMAND])
+			command = blobmsg_get_string(tb[REBOOT_COMMAND]);
+	}
+
+	if (procd_shutdown_command(RB_AUTOBOOT, command))
+		return UBUS_STATUS_INVALID_ARGUMENT;
 	return 0;
 }
 
