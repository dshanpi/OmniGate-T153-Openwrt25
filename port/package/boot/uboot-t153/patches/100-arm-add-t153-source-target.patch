From: T153 OpenWrt port maintainers
Subject: [PATCH] ARM: add isolated T153 source SPL and resident PSCI target

Select the board-local DDR4, MMC and CPU_ON implementation through its own
ARM target. Existing platform defaults and targets retain their behavior.
The board files and defconfigs are installed by the OpenWrt package overlay.

---
--- a/arch/arm/Kconfig
+++ b/arch/arm/Kconfig
@@ -712,6 +712,21 @@
 	select DM
 	select OF_CONTROL
 	imply CMD_DM
+
+config TARGET_DSHANPI_T153_SOURCE
+    bool "DshanPI T153MX OmniGate (experimental source-only SPL)"
+    select CPU_V7A
+    select SUPPORT_SPL
+    help
+      Source-only DDR4 training, FEL return and read-only MMC loading.
+      The board port provides source-only DDR4 and a resident CPU_ON monitor.
+
+config TARGET_DSHANPI_T153_RAM
+    bool "DshanPI T153MX OmniGate (RAM chainload only)"
+    select CPU_V7A
+    help
+      Experimental U-Boot proper for already initialized 512 MiB DRAM.
+      Does not include DDR initialization, SPL or a cold-boot image.
 
 config TARGET_VEXPRESS_CA9X4
 	bool "Support vexpress_ca9x4"
@@ -2469,3 +2484,5 @@
 source "arch/arm/Kconfig.debug"
 
 endmenu
+
+source "board/dshanpi/t153/Kconfig"
--- a/arch/arm/dts/Makefile
+++ b/arch/arm/dts/Makefile
@@ -1,3 +1,5 @@
+dtb-$(CONFIG_TARGET_DSHANPI_T153_SOURCE) += sun8i-t153-dshanpi-omnigate-uboot.dtb
+dtb-$(CONFIG_TARGET_DSHANPI_T153_RAM) += sun8i-t153-dshanpi-omnigate-uboot.dtb
 # SPDX-License-Identifier: GPL-2.0+
 
 dtb-$(CONFIG_TARGET_SMARTWEB) += at91sam9260-smartweb.dtb
--- a/arch/arm/cpu/armv7/Kconfig
+++ b/arch/arm/cpu/armv7/Kconfig
@@ -54,7 +54,8 @@
 config ARMV7_SECURE_MAX_SIZE
 	hex
 	depends on ARMV7_SECURE_BASE && ARCH_STM32MP || MACH_SUN6I \
-			|| MACH_SUN7I || MACH_SUN8I
+			|| MACH_SUN7I || MACH_SUN8I || T153_PSCI_COLD_SMP
+	default 0x8000 if T153_PSCI_COLD_SMP
 	default 0xbc00 if MACH_SUN8I && !MACH_SUN8I_H3
 	default 0x3c00 if MACH_SUN8I && MACH_SUN8I_H3
 	default 0x10000
@@ -62,7 +63,8 @@
 config ARM_GIC_BASE_ADDRESS
 	hex
 	depends on ARMV7_NONSEC
-	depends on ARCH_EXYNOS5 || MACH_SUN8I_R528
+	depends on ARCH_EXYNOS5 || MACH_SUN8I_R528 || T153_PSCI_COLD_SMP
+	default 0x03400000 if T153_PSCI_COLD_SMP
 	default 0x10480000 if ARCH_EXYNOS5
 	default 0x03020000 if MACH_SUN8I_R528
 	help
