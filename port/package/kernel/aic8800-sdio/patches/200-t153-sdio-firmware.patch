--- /dev/null
+++ b/src/SDIO/driver_fw/driver/aic8800/aic_firmware.h
@@ -0,0 +1,15 @@
+/* SPDX-License-Identifier: GPL-2.0-only */
+#ifndef AIC_OPENWRT_FIRMWARE_H
+#define AIC_OPENWRT_FIRMWARE_H
+#include <linux/firmware.h>
+#include <linux/errno.h>
+/* This package intentionally targets the board's AIC8800D80, not USB variants. */
+static inline int aic_request_firmware(const struct firmware **fw,
+                                      const char *name, struct device *dev)
+{
+    char path[160];
+    if (snprintf(path, sizeof(path), "aic8800D80/%s", name) >= sizeof(path))
+        return -ENAMETOOLONG;
+    return request_firmware(fw, path, dev);
+}
+#endif
