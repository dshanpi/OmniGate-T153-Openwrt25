From: T153 OpenWrt port
Subject: [PATCH] Respect SDIO host limits and use namespaced firmware loader

--- a/src/SDIO/driver_fw/driver/aic8800/aic8800_bsp/aic_bsp_driver.c
+++ b/src/SDIO/driver_fw/driver/aic8800/aic8800_bsp/aic_bsp_driver.c
@@ -11,6 +11,7 @@
  ******************************************************************************
  */
 
+#include "../aic_firmware.h"
 #include <linux/list.h>
 #include <linux/version.h>
 #include <linux/delay.h>
@@ -502,7 +503,7 @@
 	printk("%s: request firmware = %s \n", __func__ ,name);
 
 
-	ret = request_firmware(&fw, name, NULL);
+	ret = aic_request_firmware(&fw, name, NULL);
 
 	if (ret < 0) {
 		printk("Load %s fail\n", name);
@@ -521,7 +522,8 @@
 
 
 	buffer = vmalloc(size);
-	memset(buffer, 0, size);
+    if (!buffer) { release_firmware(fw); return -ENOMEM; }
+    memset(buffer, 0, size);
 	memcpy(buffer, dst, size);
 
 	*fw_buf = buffer;
--- a/src/SDIO/driver_fw/driver/aic8800/aic8800_bsp/aicsdio.c
+++ b/src/SDIO/driver_fw/driver/aic8800/aic8800_bsp/aicsdio.c
@@ -1825,7 +1825,8 @@
     udelay(100);
 #if 1//SDIO CLOCK SETTING
 	if (feature.sdio_clock > 0) {
-		host->ios.clock = feature.sdio_clock;
+		/* Respect the MMC host/board limit; do not force the vendor 150 MHz default. */
+		host->ios.clock = min_t(unsigned int, feature.sdio_clock, host->f_max);
 		host->ops->set_ios(host, &host->ios);
 		sdio_dbg("Set SDIO Clock %d MHz\n", host->ios.clock/1000000);
 	}
@@ -1945,7 +1946,8 @@
     msleep(1);
 #if 1//SDIO CLOCK SETTING
 	if ((feature.sdio_clock > 0) && (host->ios.timing != MMC_TIMING_UHS_DDR50)) {
-		host->ios.clock = feature.sdio_clock;
+		/* Respect the MMC host/board limit; do not force the vendor 150 MHz default. */
+		host->ios.clock = min_t(unsigned int, feature.sdio_clock, host->f_max);
 		host->ops->set_ios(host, &host->ios);
 		sdio_dbg("Set SDIO Clock %d MHz\n", host->ios.clock/1000000);
 	}
@@ -2091,7 +2093,7 @@
 
 void get_fw_path(char* fw_path){
 	if (strlen(aic_fw_path) > 0) {
-		memcpy(fw_path, aic_fw_path, strlen(aic_fw_path));
+		strscpy(fw_path, aic_fw_path, FW_PATH_MAX);
 	}else{
 		snprintf(fw_path, FW_PATH_MAX, "%s%s", aic_default_fw_path, aicbsp_chip_fw_subdir());
 	}
