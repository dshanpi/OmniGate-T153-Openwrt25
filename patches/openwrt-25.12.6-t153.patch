+
+#include <linux/hrtimer.h>
+#include <linux/reset.h>
+#include <linux/phy/phy.h>
+#include <linux/platform_device.h>
+
+#include "m_can.h"
+
+/* T153 top register bit 0 selects the vendor DMA engine. Use MMIO FIFO I/O. */
+#define T153_CAN_DMA_MODE BIT(0)
+
+struct m_can_plat_priv {
+	struct m_can_classdev cdev;
+
+	void __iomem *base;
+	void __iomem *mram_base;
+	void __iomem *top;
+	struct clk *mbus;
+	struct reset_control *core_reset;
+	struct reset_control *sys_reset;
+};
+
+static inline struct m_can_plat_priv *cdev_to_priv(struct m_can_classdev *cdev)
+{
+	return container_of(cdev, struct m_can_plat_priv, cdev);
+}
+
+static u32 iomap_read_reg(struct m_can_classdev *cdev, int reg)
+{
+	struct m_can_plat_priv *priv = cdev_to_priv(cdev);
+
+	return readl(priv->base + reg);
+}
+
+static int iomap_read_fifo(struct m_can_classdev *cdev, int offset, void *val, size_t val_count)
+{
+	struct m_can_plat_priv *priv = cdev_to_priv(cdev);
+	void __iomem *src = priv->mram_base + offset;
+
+	while (val_count--) {
+		*(unsigned int *)val = ioread32(src);
+		val += 4;
+		src += 4;
+	}
+
+	return 0;
+}
+
+static int iomap_write_reg(struct m_can_classdev *cdev, int reg, int val)
+{
+	struct m_can_plat_priv *priv = cdev_to_priv(cdev);
+
+	writel(val, priv->base + reg);
+
+	return 0;
+}
+
+static int iomap_write_fifo(struct m_can_classdev *cdev, int offset,
+			    const void *val, size_t val_count)
+{
+	struct m_can_plat_priv *priv = cdev_to_priv(cdev);
+	void __iomem *dst = priv->mram_base + offset;
+
+	while (val_count--) {
+		iowrite32(*(unsigned int *)val, dst);
+		val += 4;
+		dst += 4;
+	}
+
+	return 0;
+}
+
+static const struct m_can_ops m_can_plat_ops = {
+	.read_reg = iomap_read_reg,
+	.write_reg = iomap_write_reg,
+	.write_fifo = iomap_write_fifo,
+	.read_fifo = iomap_read_fifo,
+};
+
+static int m_can_plat_probe(struct platform_device *pdev)
+{
+	struct m_can_classdev *mcan_class;
+	struct m_can_plat_priv *priv;
+	struct resource *res;
+	void __iomem *addr;
+	void __iomem *mram_addr;
+	struct phy *transceiver;
+	int irq = 0, ret = 0;
+
+	mcan_class = m_can_class_allocate_dev(&pdev->dev,
+					      sizeof(struct m_can_plat_priv));
+	if (!mcan_class)
+		return -ENOMEM;
+
+	priv = cdev_to_priv(mcan_class);
+	priv->top = devm_platform_ioremap_resource_byname(pdev, "top");
+	if (IS_ERR(priv->top)) {
+		ret = PTR_ERR(priv->top);
+		goto probe_fail;
+	}
+	priv->mbus = devm_clk_get(&pdev->dev, "mbus");
+	if (IS_ERR(priv->mbus)) {
+		ret = PTR_ERR(priv->mbus);
+		goto probe_fail;
+	}
+	priv->core_reset = devm_reset_control_get_exclusive(&pdev->dev, "core");
+	if (IS_ERR(priv->core_reset)) {
+		ret = PTR_ERR(priv->core_reset);
+		goto probe_fail;
+	}
+	priv->sys_reset = devm_reset_control_get_shared(&pdev->dev, "sys");
+	if (IS_ERR(priv->sys_reset)) {
+		ret = PTR_ERR(priv->sys_reset);
+		goto probe_fail;
+	}
+
+
+	ret = m_can_class_get_clocks(mcan_class);
+	if (ret)
+		goto probe_fail;
+
+	addr = devm_platform_ioremap_resource_byname(pdev, "m_can");
+	if (IS_ERR(addr)) {
+		ret = PTR_ERR(addr);
+		goto probe_fail;
+	}
+
+	if (device_property_present(mcan_class->dev, "interrupts") ||
+	    device_property_present(mcan_class->dev, "interrupt-names")) {
+		irq = platform_get_irq_byname(pdev, "int0");
+		if (irq < 0) {
+			ret = irq;
+			goto probe_fail;
+		}
+	}
+
+	/* message ram could be shared */
+	res = platform_get_resource_byname(pdev, IORESOURCE_MEM, "message_ram");
+	if (!res) {
+		ret = -ENODEV;
+		goto probe_fail;
+	}
+
+	ret = m_can_check_mram_cfg(mcan_class, resource_size(res));
+	if (ret)
+		goto probe_fail;
+
+	mram_addr = devm_ioremap(&pdev->dev, res->start, resource_size(res));
+	if (!mram_addr) {
+		ret = -ENOMEM;
+		goto probe_fail;
+	}
+
+	transceiver = devm_phy_optional_get(&pdev->dev, NULL);
+	if (IS_ERR(transceiver)) {
+		ret = PTR_ERR(transceiver);
+		dev_err_probe(&pdev->dev, ret, "failed to get phy\n");
+		goto probe_fail;
+	}
+
+	if (transceiver)
+		mcan_class->can.bitrate_max = transceiver->attrs.max_link_rate;
+
+	priv->base = addr;
+	priv->mram_base = mram_addr;
+
+	mcan_class->net->irq = irq;
+	mcan_class->pm_clock_support = 1;
+	mcan_class->pm_wake_source = 0;
+	mcan_class->can.clock.freq = clk_get_rate(mcan_class->cclk);
+	mcan_class->dev = &pdev->dev;
+	mcan_class->transceiver = transceiver;
+
+	mcan_class->ops = &m_can_plat_ops;
+
+	mcan_class->is_peripheral = false;
+
+	platform_set_drvdata(pdev, mcan_class);
+
+	pm_runtime_enable(mcan_class->dev);
+	ret = m_can_class_register(mcan_class);
+	if (ret)
+		goto out_runtime_disable;
+
+	return ret;
+
+out_runtime_disable:
+	pm_runtime_disable(mcan_class->dev);
+probe_fail:
+	m_can_class_free_dev(mcan_class->net);
+	return ret;
+}
+
+static __maybe_unused int m_can_suspend(struct device *dev)
+{
+	return m_can_class_suspend(dev);
+}
+
+static __maybe_unused int m_can_resume(struct device *dev)
+{
+	return m_can_class_resume(dev);
+}
+
+static void m_can_plat_remove(struct platform_device *pdev)
+{
+	struct m_can_plat_priv *priv = platform_get_drvdata(pdev);
+	struct m_can_classdev *mcan_class = &priv->cdev;
+
+	m_can_class_unregister(mcan_class);
+	pm_runtime_disable(mcan_class->dev);
+	m_can_class_free_dev(mcan_class->net);
+}
+
+static int __maybe_unused m_can_runtime_suspend(struct device *dev)
+{
+	struct m_can_plat_priv *priv = dev_get_drvdata(dev);
+
+	reset_control_assert(priv->core_reset);
+	reset_control_assert(priv->sys_reset);
+	clk_disable_unprepare(priv->cdev.cclk);
+	clk_disable_unprepare(priv->cdev.hclk);
+	clk_disable_unprepare(priv->mbus);
+	return 0;
+}
+
+static int __maybe_unused m_can_runtime_resume(struct device *dev)
+{
+	struct m_can_plat_priv *priv = dev_get_drvdata(dev);
+	int ret;
+
+	ret = clk_prepare_enable(priv->mbus);
+	if (ret)
+		return ret;
+	ret = clk_prepare_enable(priv->cdev.hclk);
+	if (ret)
+		goto disable_mbus;
+	ret = clk_prepare_enable(priv->cdev.cclk);
+	if (ret)
+		goto disable_hclk;
+	ret = reset_control_deassert(priv->sys_reset);
+	if (ret)
+		goto disable_cclk;
+	ret = reset_control_deassert(priv->core_reset);
+	if (ret)
+		goto assert_sys;
+	writel(readl(priv->top) & ~T153_CAN_DMA_MODE, priv->top);
+	return 0;
+assert_sys:
+	reset_control_assert(priv->sys_reset);
+disable_cclk:
+	clk_disable_unprepare(priv->cdev.cclk);
+disable_hclk:
+	clk_disable_unprepare(priv->cdev.hclk);
+disable_mbus:
+	clk_disable_unprepare(priv->mbus);
+	return ret;
+}
+
+static const struct dev_pm_ops m_can_pmops = {
+	SET_RUNTIME_PM_OPS(m_can_runtime_suspend,
+			   m_can_runtime_resume, NULL)
+	SET_SYSTEM_SLEEP_PM_OPS(m_can_suspend, m_can_resume)
+};
+
+static const struct of_device_id m_can_of_table[] = {
+	{ .compatible = "allwinner,sun8i-t153-can", .data = NULL },
+	{ /* sentinel */ },
+};
+MODULE_DEVICE_TABLE(of, m_can_of_table);
+
+static struct platform_driver m_can_plat_driver = {
+	.driver = {
+		.name = KBUILD_MODNAME,
+		.of_match_table = m_can_of_table,
+		.pm     = &m_can_pmops,
+	},
+	.probe = m_can_plat_probe,
+	.remove = m_can_plat_remove,
+};
+
+module_platform_driver(m_can_plat_driver);
+
+MODULE_AUTHOR("Dong Aisheng <b29396@freescale.com>");
+MODULE_AUTHOR("Dan Murphy <dmurphy@ti.com>");
+MODULE_LICENSE("GPL v2");
+MODULE_DESCRIPTION("Allwinner T153 M_CAN platform glue");
diff --git a/target/linux/sunxi/files/drivers/net/ethernet/stmicro/stmmac/dwmac-sun8i-t153.c b/target/linux/sunxi/files/drivers/net/ethernet/stmicro/stmmac/dwmac-sun8i-t153.c
new file mode 100644
--- /dev/null
+++ b/target/linux/sunxi/files/drivers/net/ethernet/stmicro/stmmac/dwmac-sun8i-t153.c
@@ -0,0 +1,154 @@
+// SPDX-License-Identifier: GPL-2.0-only
+/*
+ * Allwinner T153 GMAC-211 glue for upstream stmmac.
+ * Register definitions derived from Allwinner's GPL-2.0 dwmac-sunxi driver.
+ * Copyright (c) 2020-2024 Allwinner Technology Co., Ltd.
+ */
+#include <linux/bitfield.h>
+#include <linux/clk.h>
+#include <linux/io.h>
+#include <linux/module.h>
+#include <linux/of.h>
+#include <linux/platform_device.h>
+#include <linux/reset.h>
+#include "stmmac_platform.h"
+
+#define T153_RGMII_EN	BIT(2)
+#define T153_RMII_EN	BIT(13)
+#define T153_TX_DELAY_LO	GENMASK(12, 10)
+#define T153_TX_DELAY_HI	GENMASK(17, 16)
+#define T153_RX_DELAY	GENMASK(9, 5)
+
+struct t153_dwmac {
+	void __iomem *syscfg;
+	struct clk_bulk_data bus_clks[2];
+	struct clk *phy_clk;
+	struct reset_control *ahb_reset;
+	u32 config;
+};
+
+static int t153_dwmac_init(struct platform_device *pdev, void *priv)
+{
+	struct t153_dwmac *dwmac = priv;
+	int ret;
+
+	ret = reset_control_deassert(dwmac->ahb_reset);
+	if (ret)
+		return ret;
+	ret = clk_bulk_prepare_enable(ARRAY_SIZE(dwmac->bus_clks), dwmac->bus_clks);
+	if (ret)
+		goto assert_reset;
+	ret = clk_prepare_enable(dwmac->phy_clk);
+	if (ret)
+		goto disable_bus;
+	writel(dwmac->config, dwmac->syscfg);
+	return 0;
+
+disable_bus:
+	clk_bulk_disable_unprepare(ARRAY_SIZE(dwmac->bus_clks), dwmac->bus_clks);
+assert_reset:
+	reset_control_assert(dwmac->ahb_reset);
+	return ret;
+}
+
+static void t153_dwmac_exit(struct platform_device *pdev, void *priv)
+{
+	struct t153_dwmac *dwmac = priv;
+
+	writel(0, dwmac->syscfg);
+	clk_disable_unprepare(dwmac->phy_clk);
+	clk_bulk_disable_unprepare(ARRAY_SIZE(dwmac->bus_clks), dwmac->bus_clks);
+	reset_control_assert(dwmac->ahb_reset);
+}
+
+static int t153_dwmac_probe(struct platform_device *pdev)
+{
+	struct device *dev = &pdev->dev;
+	struct device_node *np = dev->of_node;
+	struct plat_stmmacenet_data *plat;
+	struct stmmac_resources res;
+	struct t153_dwmac *dwmac;
+	u32 tx_delay = 0, rx_delay = 0;
+	int ret;
+
+	dwmac = devm_kzalloc(dev, sizeof(*dwmac), GFP_KERNEL);
+	if (!dwmac)
+		return -ENOMEM;
+	ret = stmmac_get_platform_resources(pdev, &res);
+	if (ret)
+		return ret;
+	plat = devm_stmmac_probe_config_dt(pdev, res.mac);
+	if (IS_ERR(plat))
+		return PTR_ERR(plat);
+	dwmac->syscfg = devm_platform_ioremap_resource(pdev, 1);
+	if (IS_ERR(dwmac->syscfg))
+		return PTR_ERR(dwmac->syscfg);
+	/*
+	 * The DT helper already acquired this reset as shared.  Keep its
+	 * deassert/assert pair in init/exit so the configuration registers are
+	 * accessible before stmmac probes, including on resume.  Do not let the
+	 * core take a second deassert reference to the same reset.
+	 */
+	dwmac->ahb_reset = plat->stmmac_ahb_rst;
+	plat->stmmac_ahb_rst = NULL;
+	dwmac->bus_clks[0].id = "ahb-sw";
+	dwmac->bus_clks[1].id = "mbus-sw";
+	ret = devm_clk_bulk_get(dev, ARRAY_SIZE(dwmac->bus_clks), dwmac->bus_clks);
+	if (ret)
+		return dev_err_probe(dev, ret, "bus configuration clocks\n");
+	if (of_property_read_bool(np, "allwinner,provide-phy-clock")) {
+		dwmac->phy_clk = devm_clk_get(dev, "phy");
+		if (IS_ERR(dwmac->phy_clk))
+			return dev_err_probe(dev, PTR_ERR(dwmac->phy_clk), "PHY clock\n");
+	}
+
+	of_property_read_u32(np, "allwinner,tx-delay-taps", &tx_delay);
+	of_property_read_u32(np, "allwinner,rx-delay-taps", &rx_delay);
+	if (tx_delay > 31 || rx_delay > 31)
+		return dev_err_probe(dev, -EINVAL, "delay taps must be 0..31\n");
+	switch (plat->mac_interface) {
+	case PHY_INTERFACE_MODE_RGMII:
+	case PHY_INTERFACE_MODE_RGMII_ID:
+	case PHY_INTERFACE_MODE_RGMII_RXID:
+	case PHY_INTERFACE_MODE_RGMII_TXID:
+		dwmac->config = T153_RGMII_EN |
+			(of_property_read_bool(np, "allwinner,external-rgmii-clock") ? 1 : 2);
+		break;
+	case PHY_INTERFACE_MODE_RMII:
+		dwmac->config = T153_RMII_EN;
+		break;
+	default:
+		return dev_err_probe(dev, -EINVAL, "unsupported PHY interface\n");
+	}
+	dwmac->config |= FIELD_PREP(T153_TX_DELAY_LO, tx_delay & 7) |
+			 FIELD_PREP(T153_TX_DELAY_HI, tx_delay >> 3) |
+			 FIELD_PREP(T153_RX_DELAY, rx_delay);
+	plat->bsp_priv = dwmac;
+	plat->init = t153_dwmac_init;
+	plat->exit = t153_dwmac_exit;
+	plat->host_dma_width = 32;
+	plat->flags |= STMMAC_FLAG_SPH_DISABLE;
+	plat->has_gmac4 = 1;
+	plat->has_gmac = 0;
+	plat->pmt = 1;
+	/* The vendor hardware reference specifies the 200 MHz CSR clock. */
+	plat->clk_csr = 4;
+	return devm_stmmac_pltfr_probe(pdev, plat, &res);
+}
+
+static const struct of_device_id t153_dwmac_match[] = {
+	{ .compatible = "allwinner,sun8i-t153-dwmac" },
+	{ }
+};
+MODULE_DEVICE_TABLE(of, t153_dwmac_match);
+static struct platform_driver t153_dwmac_driver = {
+	.probe = t153_dwmac_probe,
+	.driver = {
+		.name = "dwmac-sun8i-t153",
+		.of_match_table = t153_dwmac_match,
+		.pm = &stmmac_pltfr_pm_ops,
+	},
+};
+module_platform_driver(t153_dwmac_driver);
+MODULE_DESCRIPTION("Allwinner T153 DWMAC glue");
+MODULE_LICENSE("GPL");
diff --git a/target/linux/sunxi/files/drivers/phy/allwinner/phy-sun8i-t153-usb.c b/target/linux/sunxi/files/drivers/phy/allwinner/phy-sun8i-t153-usb.c
new file mode 100644
--- /dev/null
+++ b/target/linux/sunxi/files/drivers/phy/allwinner/phy-sun8i-t153-usb.c
@@ -0,0 +1,172 @@
+// SPDX-License-Identifier: GPL-2.0-only
+/*
+ * Allwinner T153 AW PHY v1.01, host mode.
+ * Register sequences derived from Allwinner's GPL-2.0 sunxi-awphy-plat.c
+ * and sunxi-hci.c, Copyright (c) 2020-2024 Allwinner Technology Co., Ltd.
+ * The USB0 gadget/OTG switch is intentionally not implemented here.
+ */
+#include <linux/clk.h>
+#include <linux/io.h>
+#include <linux/module.h>
+#include <linux/mutex.h>
+#include <linux/of.h>
+#include <linux/phy/phy.h>
+#include <linux/platform_device.h>
+#include <linux/reset.h>
+
+#define T153_PHY_CTRL(n)	(0x10 + 0x20 * (n))
+#define T153_PHY_RST(n)	(0x28 + 0x20 * (n))
+#define T153_SIDDQ	BIT(3)
+#define T153_RESET_N	BIT(0)
+#define T153_MAP_SEL	BIT(0)
+/* OHCI bulk-out bypass, INCR8, INCR4, INCR alignment, UTMI. */
+#define T153_HOST_BYPASS	(BIT(15) | BIT(10) | BIT(9) | BIT(8) | BIT(0))
+
+struct t153_usb_phy;
+struct t153_usb_port {
+	struct t153_usb_phy *parent;
+	struct phy *phy;
+	void __iomem *pmu;
+	unsigned int index;
+};
+
+struct t153_usb_phy {
+	void __iomem *regs;
+	void __iomem *top;
+	struct clk_bulk_data clocks[3];
+	struct reset_control *reset;
+	struct mutex lock;
+	struct t153_usb_port ports[2];
+};
+
+static int t153_usb_init(struct phy *phy)
+{
+	struct t153_usb_port *port = phy_get_drvdata(phy);
+	struct t153_usb_phy *priv = port->parent;
+	u32 val;
+	int ret;
+
+	ret = clk_bulk_prepare_enable(ARRAY_SIZE(priv->clocks), priv->clocks);
+	if (ret)
+		return ret;
+	ret = reset_control_deassert(priv->reset);
+	if (ret) {
+		clk_bulk_disable_unprepare(ARRAY_SIZE(priv->clocks), priv->clocks);
+		return ret;
+	}
+	mutex_lock(&priv->lock);
+	val = readl(priv->regs + T153_PHY_CTRL(port->index));
+	writel(val & ~T153_SIDDQ, priv->regs + T153_PHY_CTRL(port->index));
+	val = readl(priv->regs + T153_PHY_RST(port->index));
+	writel(val | T153_RESET_N, priv->regs + T153_PHY_RST(port->index));
+	val = readl(priv->top + 0x08);
+	writel(val | T153_MAP_SEL, priv->top + 0x08);
+	val = readl(port->pmu);
+	writel(val | T153_HOST_BYPASS, port->pmu);
+	mutex_unlock(&priv->lock);
+	return 0;
+}
+
+static int t153_usb_exit(struct phy *phy)
+{
+	struct t153_usb_port *port = phy_get_drvdata(phy);
+	struct t153_usb_phy *priv = port->parent;
+	u32 val;
+
+	mutex_lock(&priv->lock);
+	val = readl(port->pmu);
+	writel(val & ~T153_HOST_BYPASS, port->pmu);
+	val = readl(priv->regs + T153_PHY_RST(port->index));
+	writel(val & ~T153_RESET_N, priv->regs + T153_PHY_RST(port->index));
+	val = readl(priv->regs + T153_PHY_CTRL(port->index));
+	writel(val | T153_SIDDQ, priv->regs + T153_PHY_CTRL(port->index));
+	mutex_unlock(&priv->lock);
+	reset_control_assert(priv->reset);
+	clk_bulk_disable_unprepare(ARRAY_SIZE(priv->clocks), priv->clocks);
+	return 0;
+}
+
+static int t153_usb_set_mode(struct phy *phy, enum phy_mode mode, int submode)
+{
+	if (mode != PHY_MODE_USB_HOST && mode != PHY_MODE_USB_HOST_LS &&
+	    mode != PHY_MODE_USB_HOST_FS && mode != PHY_MODE_USB_HOST_HS)
+		return -EOPNOTSUPP;
+	return 0;
+}
+
+static const struct phy_ops t153_usb_ops = {
+	.init = t153_usb_init,
+	.exit = t153_usb_exit,
+	.set_mode = t153_usb_set_mode,
+	.owner = THIS_MODULE,
+};
+
+static struct phy *t153_usb_xlate(struct device *dev, const struct of_phandle_args *args)
+{
+	struct t153_usb_phy *priv = dev_get_drvdata(dev);
+
+	if (args->args_count != 1 || args->args[0] >= ARRAY_SIZE(priv->ports))
+		return ERR_PTR(-EINVAL);
+	/* Port 0 is wired as a device port on OmniGate; do not switch its role. */
+	if (!args->args[0])
+		return ERR_PTR(-EOPNOTSUPP);
+	return priv->ports[args->args[0]].phy;
+}
+
+static int t153_usb_probe(struct platform_device *pdev)
+{
+	struct device *dev = &pdev->dev;
+	struct phy_provider *provider;
+	struct t153_usb_phy *priv;
+	struct t153_usb_port *port;
+	int ret;
+
+	priv = devm_kzalloc(dev, sizeof(*priv), GFP_KERNEL);
+	if (!priv)
+		return -ENOMEM;
+	mutex_init(&priv->lock);
+	priv->regs = devm_platform_ioremap_resource(pdev, 0);
+	if (IS_ERR(priv->regs))
+		return PTR_ERR(priv->regs);
+	priv->top = devm_platform_ioremap_resource(pdev, 1);
+	if (IS_ERR(priv->top))
+		return PTR_ERR(priv->top);
+	priv->clocks[0].id = "bus";
+	priv->clocks[1].id = "bus-cfg";
+	priv->clocks[2].id = "ref";
+	ret = devm_clk_bulk_get(dev, ARRAY_SIZE(priv->clocks), priv->clocks);
+	if (ret)
+		return dev_err_probe(dev, ret, "PHY clocks\n");
+	priv->reset = devm_reset_control_get_shared(dev, NULL);
+	if (IS_ERR(priv->reset))
+		return dev_err_probe(dev, PTR_ERR(priv->reset), "USB subsystem reset\n");
+	port = &priv->ports[1];
+	port->parent = priv;
+	port->index = 1;
+	port->pmu = devm_platform_ioremap_resource(pdev, 2);
+	if (IS_ERR(port->pmu))
+		return PTR_ERR(port->pmu);
+	port->phy = devm_phy_create(dev, NULL, &t153_usb_ops);
+	if (IS_ERR(port->phy))
+		return PTR_ERR(port->phy);
+	phy_set_drvdata(port->phy, port);
+	platform_set_drvdata(pdev, priv);
+	provider = devm_of_phy_provider_register(dev, t153_usb_xlate);
+	return PTR_ERR_OR_ZERO(provider);
+}
+
+static const struct of_device_id t153_usb_match[] = {
+	{ .compatible = "allwinner,sun8i-t153-usb-phy" },
+	{ }
+};
+MODULE_DEVICE_TABLE(of, t153_usb_match);
+static struct platform_driver t153_usb_driver = {
+	.probe = t153_usb_probe,
+	.driver = {
+		.name = "phy-sun8i-t153-usb",
+		.of_match_table = t153_usb_match,
+	},
+};
+module_platform_driver(t153_usb_driver);
+MODULE_DESCRIPTION("Allwinner T153 USB2 host PHY");
+MODULE_LICENSE("GPL");
diff --git a/target/linux/sunxi/files/drivers/pinctrl/sunxi/pinctrl-sun8i-t153.c b/target/linux/sunxi/files/drivers/pinctrl/sunxi/pinctrl-sun8i-t153.c
