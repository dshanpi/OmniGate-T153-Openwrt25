diff --git a/package/utils/aic8800d80-bt/tests/test-helper.c b/package/utils/aic8800d80-bt/tests/test-helper.c
new file mode 100644
--- /dev/null
+++ b/package/utils/aic8800d80-bt/tests/test-helper.c
@@ -0,0 +1,149 @@
+// SPDX-License-Identifier: GPL-2.0-or-later
+#define main helper_main
+#include "../src/aic8800d80-bt.c"
+#undef main
+#include <assert.h>
+#include <sys/socket.h>
+#include <sys/wait.h>
+
+static void test_aon(void)
+{
+	/* Original SDK ARM layout: 3 u32, 12 u16, 7 u32, 14 u16,
+	 * 2 u32, 1 u16 and 2 zero tail-padding bytes. */
+	static const uint8_t expected[AON_SIZE] = {
+		0x00,0xd7,0x18,0x00,0x00,0xf7,0x18,0x00,0x40,0x00,0x00,0x00,
+		0x28,0x00,0x90,0x01,0x90,0x01,0x03,0x00,0x02,0x00,0x03,0x00,
+		0x02,0x00,0x28,0x00,0x00,0x02,0x14,0x00,0x15,0x00,0x14,0x00,
+		0x20,0x00,0x00,0x00,0x08,0x00,0x00,0x00,0xff,0xff,0xff,0xff,
+		0x00,0x00,0x00,0x00,0x20,0x4e,0x00,0x00,0x13,0x01,0x00,0x00,
+		0x02,0x73,0x06,0x20,0x07,0x00,0x40,0x00,0x48,0x00,0x47,0x00,
+		0x20,0x00,0x00,0x02,0xa4,0x01,0x64,0x00,0x64,0x00,0x08,0x00,
+		0x18,0x00,0x28,0x00,0x8c,0x00,0x00,0x00,0x40,0x00,0x00,0x00,
+		0x20,0x4e,0x00,0x00,0x32,0x00,0x00,0x00
+	};
+	uint8_t actual[AON_SIZE];
+	encode_aon(actual);
+	assert(!memcmp(actual, expected, sizeof(expected)));
+}
+
+static void test_addresses(void)
+{
+	uint8_t addr[6];
+	assert(parse_address("02:01:02:03:04:05", addr) == 0);
+	assert(addr[0] == 2 && addr[5] == 5);
+	assert(parse_address("A0:b1:C2:d3:E4:f5", addr) == 0);
+	assert(parse_address("00:00:00:00:00:00", addr) == -1);
+	assert(parse_address("FF:FF:FF:FF:FF:FF", addr) == -1);
+	assert(parse_address("03:01:02:03:04:05", addr) == -1);
+	assert(parse_address("02:01:02:03:04:-1", addr) == -1);
+	assert(parse_address(" 2:01:02:03:04:05", addr) == -1);
+	assert(parse_address("02:01:02:03:04:05x", addr) == -1);
+	assert(parse_address("02:01:02:03:04", addr) == -1);
+}
+
+static void transaction_test(int mode, int expected_errno)
+{
+	int sv[2], status, rc, saved;
+	pid_t child;
+	assert(socketpair(AF_UNIX, SOCK_STREAM, 0, sv) == 0);
+	child = fork();
+	assert(child >= 0);
+	if (!child) {
+		uint8_t cmd[4];
+		uint8_t event[] = { 4, 0x0e, 4, 1, 0x03, 0x0c, 0 };
+		close(sv[0]);
+		assert(transfer(sv[1], cmd, sizeof(cmd), 0, monotonic_ms() + 1000) == 0);
+		assert(!memcmp(cmd, "\x01\x03\x0c\x00", 4));
+		if (mode == 1) {
+			event[4] = 0x04; /* unrelated completion must be skipped */
+			assert(write(sv[1], event, sizeof(event)) == sizeof(event));
+			event[4] = 0x03;
+		}
+		if (mode == 2)
+			event[6] = 0x12;
+		if (mode == 3) {
+			assert(write(sv[1], event, 5) == 5);
+		} else if (mode == 4) {
+			(void)delay_ms(COMMAND_TIMEOUT_MS + 100);
+		} else if (mode == 5) {
+			event[0] = 0x02;
+			assert(write(sv[1], event, sizeof(event)) == sizeof(event));
+		} else if (mode == 6) {
+			const uint8_t rejected[] = { 4, 0x0f, 4, 0x0c, 1, 0x03, 0x0c };
+			assert(write(sv[1], rejected, sizeof(rejected)) == sizeof(rejected));
+		} else {
+			assert(write(sv[1], event, sizeof(event)) == sizeof(event));
+		}
+		close(sv[1]);
+		_exit(0);
+	}
+	close(sv[1]);
+	errno = 0;
+	rc = hci_command(sv[0], 0x0c03, NULL, 0);
+	saved = errno;
+	assert(waitpid(child, &status, 0) == child);
+	assert(WIFEXITED(status) && WEXITSTATUS(status) == 0);
+	assert(expected_errno ? rc == -1 && saved == expected_errno : rc == 0);
+	close(sv[0]);
+}
+
+
+static void test_initialization_sequence(void)
+{
+	static const uint16_t opcodes[] = { 0x0c03, 0xfc70, 0xfc4d, 0xfc50, 0xfc51, 0xfc52 };
+	static const uint8_t lengths[] = { 0, 6, 104, 1, 1, 1 };
+	const uint8_t address[] = { 2, 0x11, 0x22, 0x33, 0x44, 0x55 };
+	int sv[2], status;
+	pid_t child;
+	assert(socketpair(AF_UNIX, SOCK_STREAM, 0, sv) == 0);
+	child = fork();
+	assert(child >= 0);
+	if (!child) {
+		size_t i;
+		close(sv[0]);
+		for (i = 0; i < sizeof(lengths); ++i) {
+			uint8_t header[4], payload[255], aon[AON_SIZE];
+			uint8_t response[] = { 4, 0x0e, 4, 1, opcodes[i] & 255, opcodes[i] >> 8, 0 };
+			int64_t deadline = monotonic_ms() + 1000;
+			assert(transfer(sv[1], header, 4, 0, deadline) == 0);
+			assert(header[0] == 1 && header[1] == (opcodes[i] & 255));
+			assert(header[2] == opcodes[i] >> 8 && header[3] == lengths[i]);
+			assert(transfer(sv[1], payload, lengths[i], 0, deadline) == 0);
+			if (i == 1)
+				assert(!memcmp(payload, "\x55\x44\x33\x22\x11\x02", 6));
+			if (i == 2) {
+				encode_aon(aon);
+				assert(!memcmp(payload, aon, sizeof(aon)));
+			}
+			if (i >= 3)
+				assert(payload[0] == (i == 4 ? 1 : 0));
+			/* Exercise partial serial reads as well as full event delivery. */
+			assert(write(sv[1], response, 2) == 2);
+			assert(delay_ms(5) == 0);
+			assert(write(sv[1], response + 2, sizeof(response) - 2) == sizeof(response) - 2);
+		}
+		close(sv[1]);
+		_exit(0);
+	}
+	close(sv[1]);
+	assert(initialize_controller(sv[0], address) == 0);
+	assert(waitpid(child, &status, 0) == child);
+	assert(WIFEXITED(status) && WEXITSTATUS(status) == 0);
+	close(sv[0]);
+}
+
+int main(void)
+{
+	test_aon();
+	test_addresses();
+	test_initialization_sequence();
+	transaction_test(0, 0);
+	transaction_test(1, 0);
+	transaction_test(2, EREMOTEIO);
+	transaction_test(3, EIO);
+	transaction_test(4, ETIMEDOUT);
+	transaction_test(5, EPROTO);
+	transaction_test(6, EREMOTEIO);
+	puts("PASS: 104-byte AON payload, address validation, full init sequence and HCI complete/mismatch/error/truncation/timeout/framing/status");
+	return 0;
+}
diff --git a/package/utils/aic8800d80-bt/tests/test-shutdown.c b/package/utils/aic8800d80-bt/tests/test-shutdown.c
new file mode 100644
--- /dev/null
+++ b/package/utils/aic8800d80-bt/tests/test-shutdown.c
@@ -0,0 +1,148 @@
+// SPDX-License-Identifier: GPL-2.0-or-later
+/* Exercise the production shutdown function without Bluetooth hardware.
+ * Run from the package directory:
+ * cc -std=c11 -O2 -Wall -Wextra -Werror tests/test-shutdown.c \
+ *   -Wl,--wrap=socket,--wrap=ioctl,--wrap=close -o /tmp/test-bt-shutdown
+ * /tmp/test-bt-shutdown
+ * Only shutdown_controller() is executed; helper_main() is never called.
+ */
+#define main helper_main
+#include "../src/aic8800d80-bt.c"
+#undef main
+#include <assert.h>
+#include <stdarg.h>
+#include <sys/socket.h>
+
+#define MOCK_FD 73
+#define MAX_IOCTL_CALLS 8
+
+static struct {
+	int expected_index;
+	int socket_error;
+	int ioctl_errors[MAX_IOCTL_CALLS];
+	size_t expected_ioctl_calls;
+	int close_error;
+	unsigned int socket_calls;
+	size_t ioctl_calls;
+	unsigned int close_calls;
+	char calls[MAX_IOCTL_CALLS + 3];
+	size_t call_count;
+} mock;
+
+static void record_call(char call)
+{
+	assert(mock.call_count + 1 < sizeof(mock.calls));
+	mock.calls[mock.call_count++] = call;
+	mock.calls[mock.call_count] = '\0';
+}
+
+int __wrap_socket(int domain, int type, int protocol)
+{
+	record_call('S');
+	assert(++mock.socket_calls == 1);
+	assert(domain == AF_BLUETOOTH);
+	assert(type == (SOCK_RAW | SOCK_CLOEXEC));
+	assert(protocol == BTPROTO_HCI);
+	if (mock.socket_error) {
+		errno = mock.socket_error;
+		return -1;
+	}
+	return MOCK_FD;
+}
+
+int __wrap_ioctl(int fd, unsigned long request, ...)
+{
+	va_list ap;
+	int index, error;
+
+	record_call('I');
+	assert(mock.socket_calls == 1 && !mock.socket_error);
+	assert(mock.close_calls == 0);
+	assert(fd == MOCK_FD);
+	assert(request == HCIDEVDOWN);
+	va_start(ap, request);
+	index = va_arg(ap, int);
+	va_end(ap);
+	assert(index == mock.expected_index);
+	assert(mock.ioctl_calls < mock.expected_ioctl_calls);
+	error = mock.ioctl_errors[mock.ioctl_calls++];
+	if (error) {
+		errno = error;
+		return -1;
+	}
+	return 0;
+}
+
+int __wrap_close(int fd)
+{
+	record_call('C');
+	assert(mock.socket_calls == 1 && !mock.socket_error);
+	assert(fd == MOCK_FD);
+	assert(++mock.close_calls == 1);
+	assert(mock.ioctl_calls == mock.expected_ioctl_calls);
+	/* Deliberately clobber errno to check the original ioctl error survives. */
+	errno = mock.close_error ? mock.close_error : EDOM;
+	return mock.close_error ? -1 : 0;
+}
+
+static void run_case(const char *name, int index, int socket_error,
+		     const int *ioctl_errors, size_t ioctl_calls,
+		     int close_error, int expected_result, int expected_errno,
+		     const char *expected_calls)
+{
+	int result, saved_errno;
+
+	memset(&mock, 0, sizeof(mock));
+	assert(ioctl_calls <= MAX_IOCTL_CALLS);
+	mock.expected_index = index;
+	mock.socket_error = socket_error;
+	mock.expected_ioctl_calls = ioctl_calls;
+	mock.close_error = close_error;
+	if (ioctl_calls)
+		memcpy(mock.ioctl_errors, ioctl_errors,
+		       ioctl_calls * sizeof(mock.ioctl_errors[0]));
+	errno = 0;
+	result = shutdown_controller(index);
+	saved_errno = errno;
+	assert(result == expected_result);
+	if (expected_result < 0)
+		assert(saved_errno == expected_errno);
+	assert(mock.socket_calls == 1);
+	assert(mock.ioctl_calls == ioctl_calls);
+	assert(mock.close_calls == (socket_error ? 0u : 1u));
+	assert(!strcmp(mock.calls, expected_calls));
+	printf("PASS %s (calls=%s)\n", name, mock.calls);
+}
+
+int main(void)
+{
+	static const int success[] = { 0 };
+	static const int interrupted[] = { EINTR, EINTR, 0 };
+	static const int disappeared[] = { ENODEV };
+	static const int interrupted_disappeared[] = { EINTR, ENODEV };
+	static const int denied[] = { EPERM };
+	static const int timed_out[] = { ETIMEDOUT };
+	static const int interrupted_failed[] = { EINTR, EIO };
+
+	run_case("hci0 down", 0, 0, success, 1, 0, 0, 0, "SIC");
+	run_case("exact nonzero controller index", 7, 0, success, 1, 0,
+		 0, 0, "SIC");
+	run_case("retry interrupted ioctl only", 31, 0, interrupted, 3, 0,
+		 0, 0, "SIIIC");
+	run_case("already removed controller", 7, 0, disappeared, 1, 0,
+		 0, 0, "SIC");
+	run_case("removed during retry", 7, 0, interrupted_disappeared, 2, 0,
+		 0, 0, "SIIC");
+	run_case("permission failure preserved across close", 7, 0, denied, 1, 0,
+		 -1, EPERM, "SIC");
+	run_case("timeout preserved despite close failure", 7, 0, timed_out, 1,
+		 EIO, -1, ETIMEDOUT, "SIC");
+	run_case("non-EINTR failure stops retries", 7, 0, interrupted_failed, 2,
+		 0, -1, EIO, "SIIC");
+	run_case("socket permission failure has no ioctl or close", 7, EPERM,
+		 NULL, 0, 0, -1, EPERM, "S");
+	run_case("socket fd exhaustion has no ioctl or close", 7, EMFILE,
+		 NULL, 0, 0, -1, EMFILE, "S");
+	puts("All shutdown lifecycle tests passed.");
+	return 0;
+}
