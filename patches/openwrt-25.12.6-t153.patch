diff --git a/package/boot/uboot-t153/files/board/dshanpi/t153/board.c b/package/boot/uboot-t153/files/board/dshanpi/t153/board.c
new file mode 100644
--- /dev/null
+++ b/package/boot/uboot-t153/files/board/dshanpi/t153/board.c
@@ -0,0 +1,170 @@
+// SPDX-License-Identifier: GPL-2.0+
+/* T153 OmniGate U-Boot proper: requires initialized DDR and ARM Linux handoff. */
+#include <config.h>
+#include <cpu_func.h>
+#include <env.h>
+#include <sunxi_image.h>
+#include <hang.h>
+#include <init.h>
+#include <asm/global_data.h>
+#include <asm/io.h>
+#include <linux/bitops.h>
+#include <stdio.h>
+#include <linux/libfdt.h>
+#include "t153.h"
+
+DECLARE_GLOBAL_DATA_PTR;
+
+void t153_pin(unsigned int bank, unsigned int pin, unsigned int pull)
+{
+	void *base = (void *)0x03604000 + 0x80 + bank * 0x80;
+	unsigned int shift = pin % 8 * 4;
+
+	/* UART0, SD0 and eMMC2 all use function 2 on this board. */
+	clrsetbits_le32(base + pin / 8 * 4, 0xf << shift, 2 << shift);
+	/* Drive field value 3: the hardware drive field is four bits wide. */
+	clrsetbits_le32(base + 0x20 + pin / 8 * 4, 0xf << shift, 3 << shift);
+	shift = pin % 16 * 2;
+	clrsetbits_le32(base + 0x30 + pin / 16 * 4, 3 << shift, pull << shift);
+}
+
+int board_early_init_f(void)
+{
+	/* Oscillator source, /1; do not change CPU, DDR or peripheral PLLs. */
+	clrsetbits_le32((void *)0x02002538, GENMASK(26, 24) | GENMASK(4, 0), 0);
+	setbits_le32((void *)0x02002e00, BIT(16) | BIT(0));
+	t153_pin(1, 9, 1);
+	t153_pin(1, 10, 1);
+	return 0;
+}
+
+int dram_init(void)
+{
+	/* Fixed 384 MiB safe window; physical DDR capacity is selected by the
+	 * SPL profile. Do not destructively probe RAM from U-Boot proper. */
+	gd->ram_size = CFG_SYS_SDRAM_SIZE;
+	return 0;
+}
+
+int dram_init_banksize(void)
+{
+	gd->bd->bi_dram[0].start = CFG_SYS_SDRAM_BASE;
+	gd->bd->bi_dram[0].size = CFG_SYS_SDRAM_SIZE;
+	return 0;
+}
+
+int board_init(void)
+{
+	gd->bd->bi_boot_params = CFG_SYS_SDRAM_BASE + 0x100;
+	return 0;
+}
+
+int checkboard(void)
+{
+#ifdef CONFIG_TARGET_DSHANPI_T153_SOURCE
+	puts("Board: T153 OmniGate (experimental source SPL/U-Boot)\n");
+	#ifdef CONFIG_T153_PSCI_COLD_SMP
+	puts("No vendor DDR/monitor. Four-core PSCI cold-boot profile.\n");
+#else
+	puts("No vendor DDR/monitor. Linux bring-up is currently CPU0 only.\n");
+#endif
+#else
+	puts("Board: DshanPI T153MX OmniGate (experimental RAM U-Boot)\n");
+	puts("DDR and secure monitor inherited; cold-boot SPL is not included.\n");
+#endif
+	return 0;
+}
+
+void enable_caches(void)
+{
+	icache_enable();
+	dcache_enable();
+}
+
+#if defined(CONFIG_TARGET_DSHANPI_T153_SOURCE) && !defined(CONFIG_XPL_BUILD)
+/* Only sunxi-fel's documented SPL header may request a RAM boot script.
+ * Never infer FEL mode from arbitrary DRAM contents, and never fall through
+ * to a persistent disk when a requested rescue boot fails.
+ */
+int board_late_init(void)
+{
+	const struct boot_file_head *head = (const void *)0x40000;
+
+	env_set("fel_scriptaddr", NULL);
+	/* Cold boot has no SRAM swap. Prefer its current, valid header over
+	 * any stale FEL scratch data that might survive a warm reset. */
+	if (!memcmp(head->magic, BOOT0_MAGIC, 8) &&
+	    !memcmp(head->spl_signature, SPL_SIGNATURE, 3)) {
+		switch (readb(&head->boot_media)) {
+		case 0:
+			env_set("bootdevs", "0 1");
+			break;
+		case 2:
+			env_set("bootdevs", "1 0");
+			break;
+		default:
+			env_set("t153_boot_source", "unknown");
+			return 0;
+		}
+		env_set("t153_boot_source", "mmc");
+		return 0;
+	}
+	/* The T153 FEL thunk swaps 0x40000..0x413ff with 0x66c00.
+	 * After return, 0x40000 belongs to BootROM again. The host passes
+	 * script information through the relocated header at 0x66c00. */
+	head = (const void *)0x66c00;
+	if (!memcmp(head->magic, "eGON.FEL", 8) &&
+	    !memcmp(head->spl_signature, SPL_SIGNATURE, 3) &&
+	    head->spl_signature[3] >= SPL_ENV_HEADER_VERSION &&
+	    head->spl_signature[3] <= SPL_HEADER_VERSION) {
+		env_set("t153_boot_source", "fel");
+		if (!readl(&head->fel_uEnv_length) &&
+		    readl(&head->fel_script_address) == 0x4f100000)
+			env_set_hex("fel_scriptaddr", 0x4f100000);
+		return 0;
+	}
+	env_set("t153_boot_source", "unknown");
+	return 0;
+}
+
+/* Until the T153 CPU power controller is implemented, do not advertise
+ * a factory PSCI service that does not exist in a source-only boot chain.
+ */
+int ft_board_setup(void *fdt, struct bd_info *bd)
+{
+#ifdef CONFIG_T153_PSCI_COLD_SMP
+	extern int t153_smp_fixup_dt(void *fdt);
+
+	return t153_smp_fixup_dt(fdt);
+#else
+	int node, cpus, ret;
+	const fdt32_t *reg;
+
+	node = fdt_path_offset(fdt, "/psci");
+	if (node >= 0) {
+		ret = fdt_del_node(fdt, node);
+		if (ret)
+			return ret;
+	}
+	cpus = fdt_path_offset(fdt, "/cpus");
+	if (cpus < 0)
+		return cpus;
+	fdt_for_each_subnode(node, fdt, cpus) {
+		reg = fdt_getprop(fdt, node, "reg", NULL);
+		if (!reg)
+			continue;
+		if (fdt32_to_cpu(*reg)) {
+			ret = fdt_setprop_string(fdt, node, "status", "disabled");
+			if (ret)
+				return ret;
+		} else {
+			ret = fdt_delprop(fdt, node, "enable-method");
+			if (ret && ret != -FDT_ERR_NOTFOUND)
+				return ret;
+		}
+	}
+	puts("Source boot: CPU0 only; T153 PSCI/SMP bring-up is pending.\n");
+	return 0;
+#endif
+}
+#endif
diff --git a/package/boot/uboot-t153/files/board/dshanpi/t153/ddr.c b/package/boot/uboot-t153/files/board/dshanpi/t153/ddr.c
new file mode 100644
--- /dev/null
+++ b/package/boot/uboot-t153/files/board/dshanpi/t153/ddr.c
@@ -0,0 +1,742 @@
+// SPDX-License-Identifier: GPL-2.0+
+/*
+ * T153 OmniGate fixed-geometry DDR4 initialization, reconstructed from
+ * register-level observations of the board SDK. No vendor object or
+ * executable byte array is used. See docs/DDR-SOURCE.txt for provenance,
+ * assumptions and the limits of host-side validation.
+ *
+ * All training executes in SRAM with the data cache disabled. Test areas
+ * are disposable: this entry point is ONLY for pre-DDR cold/FEL SPL.
+ */
+#ifdef T153_DDR_HOST_TEST
+#include "ddr-test-io.h"
+#else
+#include <config.h>
+#include <asm/io.h>
+#include <asm/barriers.h>
+#include <linux/delay.h>
+#include <linux/errno.h>
+#include <linux/bitops.h>
+#include <stdio.h>
+#include <string.h>
+#endif
+#include "ddr.h"
+
+#define COM 0x03110000UL
+#define CTL 0x03120000UL
+#define PHY 0x03130000UL
+#define DDR_CLK 0x02002588UL
+#define DDR_BGR 0x02002c0cUL
+#define RTC_DDR 0x070901f4UL
+#define DX(n) (PHY + 0x4000 + (n) * 0x1000)
+#define TIMEOUT_US 10000
+
+/* 'keep' is the mask of bits NOT modified, matching reset-independent RMW. */
+static void update(unsigned long addr, u32 keep, u32 value)
+{
+	writel((readl(addr) & keep) | value, addr);
+}
+
+static int await(unsigned long addr, u32 mask, u32 value)
+{
+	unsigned int n;
+
+	for (n = 0; n < TIMEOUT_US; n++) {
+		if ((readl(addr) & mask) == value)
+			return 0;
+		udelay(1);
+	}
+	printf("DDR timeout: %08lx mask=%08x expected=%08x actual=%08x\n",
+	       addr, mask, value, readl(addr));
+	return -ETIMEDOUT;
+}
+
+static int clock_init(struct t153_ddr_state *s)
+{
+	u32 pll = s->mhz * (s->mhz < 600 ? 4 : 2);
+
+	update(RTC_DDR, ~0U, BIT(2));
+	update(DDR_CLK, ~BIT(31), BIT(27));
+	update(DDR_CLK, ~BIT(30), BIT(27));
+	udelay(1);
+	update(DDR_BGR, ~BIT(0), 0);
+	update(DDR_BGR, ~BIT(16), 0);
+	udelay(1);
+	update(DDR_CLK, 0xf8ffffff, 0x09000000);
+	udelay(10);
+	update(DDR_BGR, ~0U, BIT(16));
+	update(DDR_CLK, ~0U, BIT(30) | BIT(27));
+	udelay(10);
+	update(DDR_BGR, ~0U, 1);
+	update(DDR_CLK, ~0U, BIT(31) | BIT(27));
+	update(PHY + 0x20, ~0U, BIT(5));
+	update(PHY + 0x30, ~0U, BIT(1));
+	update(PHY + 0x202c, ~0U, BIT(1));
+	update(PHY + 0x30, ~0U, BIT(16));
+	udelay(10);
+	/* 24 MHz reference; integer N plus 19-bit fractional multiplier. */
+	update(PHY + 4, 0x8000000f,
+	       (pll / 24) << 4 | (((pll % 24) << 19) / 24) << 12);
+	update(PHY + 0x14, 0xff00ffff, 0xa7000000);
+	update(PHY + 0x14, ~0U, 1);
+	update(PHY, ~0U, 0xa0000000);
+	update(PHY + 0x200, ~0U, 0xa0000000);
+	update(PHY, ~0U, BIT(27));
+	update(PHY + 0x200, ~0U, BIT(27));
+	if (await(PHY, BIT(28), BIT(28)))
+		return -ETIMEDOUT;
+	update(PHY + 0x1c, 0xfffffcf8, 0x88000000 | (s->mhz < 600));
+	update(COM + 0x500, 0xffffff0f, 0x02000030);
+	writel(0x8000, COM + 0x0c);
+	udelay(10);
+	return 0;
+}
+
+/* The two supported frequency profiles. Offsets are DDRC DRAMTMG0..14. */
+static const u16 timing_offsets[] = {
+	0x100, 0x104, 0x108, 0x10c, 0x110, 0x114, 0x118,
+	0x120, 0x124, 0x128, 0x12c, 0x130, 0x134, 0x138,
+};
+static const u32 timing[2][14] = {
+	{ 0x0c091009, 0x0002030c, 0x05050309, 0x0000400c,
+	  0x04030204, 0x03030302, 0x02020004, 0x01011002,
+	  0x00020208, 0x000e0c05, 0x440c021c, 8, 0x0a100002, 4 },
+	{ 0x0e111f10, 0x00030417, 0x0507050b, 0x0000400c,
+	  0x07030407, 0x05050403, 0x02020005, 0x02021005,
+	  0x00020309, 0x000e0c05, 0x440c021c, 8, 0x0a100002, 4 },
+};
+static const u16 bank_offsets[] = { 0x4000, 0x3000, 0x2000, 0 };
+
+static void controller_timing(struct t153_ddr_state *s)
+{
+	unsigned int i, j, profile = s->mhz == 933;
+	unsigned long bank;
+
+	s->mr[0] = profile ? 0x524 : 0x104;
+	s->mr[2] = profile ? 8 : 0;
+	for (i = 0; i < 4; i++) {
+		bank = CTL + bank_offsets[i];
+		for (j = 0; j < 14; j++)
+			writel(timing[profile][j], bank + timing_offsets[j]);
+		update(CTL + 0xd0, 0x3ffff000, 0x187);
+		writel(0x01f20000, CTL + 0xd4);
+		update(CTL + 0xd8, 0xffff00f0, 0x1705);
+		writel(0, CTL + 0x1b0);
+		writel(s->mr[0] << 16 | s->mr[1], bank + 0xdc);
+		writel(s->mr[2] << 16 | s->mr[3], bank + 0xe0);
+		writel(s->mr[4] << 16 | s->mr[5], bank + 0xe8);
+		writel(s->mr[6], bank + 0xec);
+		writel(0, CTL + 0x1b0);
+		update(bank + 0xf4, 0xfffff00f, 0xccf);
+		writel(profile ? 0x028c8406 : 0x02888405, bank + 0x190);
+		writel(0x00100202, bank + 0x194);
+		writel(profile ? 0xc06 : 0x805, bank + 0x1b4);
+		writel(profile ? 0x003800a4 : 0x001d0054, bank + 0x64);
+	}
+}
+
+static void address_map(void)
+{
+	/* HIF x16 single-rank address map. SDK para1 0x60fa/0x610a
+	 * differs only in ADDRMAP6 row15: disabled (0xf) vs HIF offset 6.
+	 * Verified by host execution of the reference address-map routine. */
+	static const u32 map[9] = {
+		0x1f1f, 0x003f0808, 0x01010100, 0x1f010101, 0x1f1f,
+		0x06060606,
+		T153_DDR_SIZE_MIB == 1024 ? 0x06060606 : 0x0f060606,
+		0x0f0f, 0x3f01,
+	};
+	unsigned int i;
+
+	writel(0x80000001, COM);
+	writel(0x80000001, COM + 4);
+	for (i = 0; i < 9; i++)
+		writel(map[i], CTL + 0x200 + 4 * i);
+}
+
+static int controller_init(struct t153_ddr_state *s)
+{
+	unsigned int i;
+
+	update(CTL + 0x250, 0xffff00f7, 0x300c);
+	update(CTL + 0x254, 0x88ffffff, 0x330000ff);
+	update(CTL + 0x270, 0xffff0000, 0x110);
+	update(CTL + 0x264, 0x00ff0000, 0x1f000030);
+	update(COM + 8, 0xff00ffff, 0x1f0000);
+	writel(0, CTL + 0x38);
+	/* DDR4, BL8, single rank, half-width, 2T command timing. */
+	writel(0xc1041410, CTL);
+	writel(0x201, CTL + 0x244);
+	for (i = 0; i < 4; i++)
+		writel(0x06000400, CTL + bank_offsets[i] + 0x240);
+	address_map();
+	controller_timing(s);
+	update(CTL + 0x1a0, 0xffffff00, 0xc0000003);
+	for (i = 0; i < 4; i++)
+		update(CTL + bank_offsets[i] + 0x180, ~0U, 0xc0000000);
+	update(CTL + 0x60, ~1U, 1);
+	writel(0, CTL + 0x320);
+	update(CTL + 0x1b0, ~1U, 0);
+	writel(1, CTL + 0x320);
+	if (await(CTL + 0x324, 1, 1))
+		return -ETIMEDOUT;
+	update(COM + 0x0c, ~0U, 0x100);
+	udelay(5);
+	return 0;
+}
+
+static u32 packed(const u8 *a)
+{
+	return a[0] | a[1] << 8 | a[2] << 16 | a[3] << 24;
+}
+
+static void latch_delays(void)
+{
+	update(PHY + 0x2000, ~0U, 4);
+	update(PHY + 0x2000, ~4U, 0);
+	update(PHY + 0xc4, ~0x80U, 0);
+	update(PHY + 0xc4, ~0U, 0x80);
+}
+
+static void set_delays(const struct t153_ddr_state *s)
+{
+	unsigned int lane;
+	unsigned long b;
+
+	for (lane = 0; lane < 2; lane++) {
+		b = DX(lane);
+		writel(packed(s->rdq + lane * 8), b + 0x70);
+		writel(packed(s->rdq + lane * 8 + 4), b + 0x74);
+		writel(0x20, b + 0x78);
+		writel(packed(s->wdq + lane * 8), b + 0x60);
+		writel(packed(s->wdq + lane * 8 + 4), b + 0x64);
+		writel((s->wdq[lane * 8] & 0x3f) | 0x1c00, b + 0x68);
+		update(b + 0x40, 0xfffffe00, s->wdqs);
+		update(b + 0x44, 0xfffffe00, s->wr[lane]);
+		writel(s->rxen[lane] << 1, b + 0x48);
+		update(b + 0x4c, 0xffffffc0, s->rd[lane]);
+		update(b + 0x50, 0xffffffc0, s->rd[lane]);
+	}
+	latch_delays();
+}
+
+static void set_read_vref(const struct t153_ddr_state *s)
+{
+	unsigned int lane;
+
+	for (lane = 0; lane < 4; lane++)
+		update(PHY + 0x2010 + lane * 4, 0xf80fff8e,
+		       (lane < 2 ? s->vref[lane] : 0x40) << 20 | 0x30);
+	udelay(5);
+}
+
+static void phy_init(struct t153_ddr_state *s)
+{
+	/* Board CA wiring, packed as four 8-bit selectors per register. */
+	static const u8 remap[28] = {
+		11, 10, 0, 14, 5, 2, 13, 8, 20, 4, 19, 24, 21, 6,
+		9, 1, 16, 3, 22, 17, 18, 7, 15, 23, 12, 25, 0, 0,
+	};
+	unsigned int i, j;
+	unsigned long b;
+
+	writel(0x01ff2f70, PHY + 0x20);
+	udelay(10);
+	writel(0x01ff6f70, PHY + 0x20);
+	udelay(10);
+	update(PHY + 0x30, ~0U, 0x100f7);
+	udelay(10);
+	update(PHY + 0x202c, ~0U, 2);
+	update(PHY + 0x80, ~0U, 2);
+	update(PHY + 0x80, 0xffffff0f, 4 << 4);
+	update(PHY + 0x2024, 0xbfff1fff, 6 << 13);
+	for (i = 0; i < 4; i++)
+		update(DX(i) + 0x28, 0xffe0c000, 9 << 16 | 0x3f0);
+	update(PHY + 0xc4, ~0U, 0x60);
+	update(PHY + 0x3064, 0xfffff801, 0x731);
+	udelay(25000);
+	set_read_vref(s);
+	writel(0x3fffffff, PHY + 0x50);
+	for (i = 0; i < 7; i++)
+		writel(packed(remap + i * 4), PHY + 0x90 + i * 4);
+	for (i = 0; i < 4; i++) {
+		b = PHY + 0x3000 + i * 0x400;
+		update(b, 0xfcf00fff, 0x021cc000);
+		update(b, ~0U, 3);
+		update(b + 8, 0xfff00fff, 0x001cc000);
+		update(b + 8, ~0U, 3);
+		update(b + 4, 0xfff00fff, 0x001cc000);
+		update(b + 4, ~0U, 3);
+	}
+	for (j = 0; j < 4; j++) {
+		for (i = 0; i < 4; i++) {
+			b = DX(i) + j * 0x400;
+			update(b, 0xfcf00fff, 0x02500000 | (i < 2 ? 0xcc000 : 0));
+			update(b, ~0U, 3);
+			update(b + 4, 0xf8ff00ff, 0x03000000 | (i < 2 ? 0x8000 : 0));
+		}
+	}
+	writel(0x3210, PHY + 0xb0);
+	writel(0xf, PHY + 0x54);
+	for (i = 0; i < 4; i++) {
+		b = PHY + 0x3000 + i * 0x400;
+		update(b + 0x24, 0xffffe0ce, 0);
+		update(b + 0x20, 0xffff80ff, s->ac << 8);
+	}
+	set_delays(s);
+	update(PHY + 0x202c, ~0U, 0x20);
+	udelay(100);
+	update(PHY + 0x202c, ~0x20U, 0);
+	writel(0x1f7f7, PHY + 0x30);
+	udelay(100);
+	writel(0x01ff6f70, PHY + 0x20);
+	udelay(100);
+}
+
+static int mr_write(unsigned int mr, u16 value)
+{
+	if (await(CTL + 0x18, 1, 0))
+		return -ETIMEDOUT;
+	writel(value, CTL + 0x14);
+	writel(mr << 12 | 0xf0, CTL + 0x10);
+	udelay(10);
+	writel(mr << 12 | 0x800000f0, CTL + 0x10);
+	udelay(10);
+	return await(CTL + 0x10, BIT(31), 0);
+}
+
+static int set_write_vref(u16 mr6)
+{
+	if (mr_write(6, mr6 | 0x80))
+		return -ETIMEDOUT;
+	udelay(10);
+	if (mr_write(6, mr6 | 0x80))
+		return -ETIMEDOUT;
+	udelay(10);
+	return mr_write(6, mr6 & ~0x80);
+}
+
+static int dfi_init(struct t153_ddr_state *s)
+{
+	unsigned int i;
+
+	writel(0, CTL + 0x320);
+	update(CTL + 0x1b0, ~0U, 1);
+	update(CTL + 0x1b0, ~0U, 0x20);
+	writel(1, CTL + 0x320);
+	if (await(CTL + 0x324, 1, 1) || await(CTL + 0x1bc, 1, 1))
+		return -ETIMEDOUT;
+	update(PHY + 0x202c, ~0U, 5);
+	update(PHY + 0x202c, ~4U, 0);
+	update(RTC_DDR, ~0U, 4);
+	writel(0, CTL + 0x320);
+	update(CTL + 0x1b0, ~0x20U, 0);
+	update(CTL + 0x30, ~0x20U, 0);
+	writel(1, CTL + 0x320);
+	if (await(CTL + 0x324, 1, 1) || await(CTL + 4, 3, 1))
+		return -ETIMEDOUT;
+	writel(0, CTL + 0x320);
+	update(CTL + 0x1b0, ~1U, 0);
+	writel(1, CTL + 0x320);
+	if (await(CTL + 0x324, 1, 1))
+		return -ETIMEDOUT;
+	for (i = 0; i < 6; i++)
+		if (mr_write(i, s->mr[i]))
+			return -ETIMEDOUT;
+	if (set_write_vref(s->mr[6]))
+		return -ETIMEDOUT;
+	writel(0, CTL + 0x320);
+	update(CTL + 0x60, ~1U, 0);
+	writel(1, CTL + 0x320);
+	return await(CTL + 0x324, 1, 1);
+}
+
+static int rxen_train(struct t153_ddr_state *s)
+{
+	unsigned int i, trp = (15 * (s->mhz / 2) + 999) / 1000;
+	int ret;
+	u32 result;
+
+	update(PHY + 0x20, ~0U, 0x1000);
+	update(PHY + 0x30, ~0U, 0x101);
+	update(PHY + 0xc4, ~0U, 4);
+	if (readl(PHY + 0x80) & 2)
+		update(PHY + 0x1030, ~0U, 0x10000);
+	update(PHY + 0x1030, 0xfffffff0, 2);
+	for (i = 0; i < 5; i++)
+		update(PHY + 0x101c + 4 * i, 0xffff0000, s->mr[i]);
+	update(PHY + 0x1048, ~0U, trp << 24);
+	update(PHY + 0x104c, 0xffff0000, 4 | (trp < 12 ? 12 : trp) << 8);
+	update(PHY + 0x1054, 0x00ffffff, 3 << 24);
+	update(PHY + 0x1064, 0xffffff00, trp + 1);
+	writel(0, PHY + 0x1080);
+	update(PHY + 0x107c, 0xffffc0ff, (s->mhz == 933 ? 12 : 8) << 8);
+	update(PHY + 0x103c, 0xffff0000, 0x221f2e40);
+	update(PHY + 0x1080, 0x0000ffff, 0x00320000);
+	update(PHY + 0x80, ~0U, 1);
+	writel(0x301, PHY + 0x1034); /* rank 0, byte lanes 0 and 1 */
+	update(PHY + 0x1034, ~0U, 0x01100000);
+	ret = await(PHY + 0x1034, BIT(31), BIT(31));
+	if (!ret && (readl(PHY + 0x1040) & 3))
+		ret = -EIO;
+	if (!ret) {
+		result = readl(PHY + 0x10d0);
+		s->rxen[0] = result >> 1;
+		s->rxen[1] = result >> 17;
+	}
+	/* Leave training mode even after a timeout or an error result. */
+	update(PHY + 0x1034, 0xfeefffff, 0);
+	update(PHY + 0x80, ~1U, 0);
+	update(PHY + 0x30, 0xfffffefe, 0);
+	update(PHY + 0x1034, 0xfeeff0f0, 0);
+	update(PHY + 0x20, ~0x1000U, 0);
+	for (i = 0; i < 4; i++)
+		update(DX(i) + 0x28, 0xffff80ff, 0x300);
+	return ret;
+}
+
+static int core_init(struct t153_ddr_state *s)
+{
+	unsigned int i;
+	int ret;
+
+	ret = clock_init(s);
+	if (ret)
+		return ret;
+	ret = controller_init(s);
+	if (ret)
+		return ret;
+	phy_init(s);
+	ret = dfi_init(s);
+	if (ret)
+		return ret;
+	for (i = 0; i < 6; i++) {
+		ret = rxen_train(s);
+		if (!ret)
+			break;
+		if (ret == -ETIMEDOUT)
+			return ret;
+	}
+	if (ret)
+		return ret;
+	set_delays(s);
+	update(0x03606014, ~0U, BIT(31));
+	udelay(10);
+	return 0;
+}
+
+static void default_state(struct t153_ddr_state *s)
+{
+	static const struct t153_ddr_state defaults = {
+		.mhz = 933, .mr = { 0x520, 0x101, 8, 0, 0, 0x400, 0x81a },
+		.rdq = { 0x12, 0x14, 0x14, 0x14, 0x1f, 0x18, 0x1f, 0x18,
+			 0x16, 0x13, 0x22, 0x11, 0x12, 0x12, 0x10, 0x11 },
+		.wdq = { 0x16, 0x16, 0x16, 0x18, 0x21, 0x1b, 0x21, 0x1e,
+			 0x1d, 0x16, 0x23, 0x12, 0x18, 0x12, 0x16, 0x14 },
+		.rd = { 0x20, 0x20 }, .wr = { 0x50, 0x50 },
+		.vref = { 0x40, 0x40 }, .ac = 0x25, .wdqs = 0x60,
+	};
+
+	*s = defaults;
+}
+
+#define TEST_WORDS 256
+#define TEST0 0x40000000UL
+#define TEST1 0x50000000UL
+
+static u32 pattern(unsigned int i, u32 salt)
+{
+	u32 v = (i ^ salt) * 1664525U + 1013904223U;
+
+	v ^= v >> 13;
+	return v ^ BIT(i & 31) ^ (i & 1 ? 0xaaaaaaaa : 0x55555555);
+}
+
+static void pattern_write(u32 salt)
+{
+	unsigned int i;
+
+	for (i = 0; i < TEST_WORDS; i++) {
+		writel(pattern(i, salt), TEST0 + i * 4);
+		writel(~pattern(i, salt), TEST1 + i * 4);
+	}
+	dsb();
+}
+
+static int pattern_check(u32 mask, u32 salt)
+{
+	unsigned int i;
+	u32 expected;
+
+	for (i = 0; i < TEST_WORDS; i++) {
+		expected = pattern(i, salt);
+		if (((readl(TEST0 + i * 4) ^ expected) & mask) ||
+		    ((readl(TEST1 + i * 4) ^ ~expected) & mask))
+			return -EIO;
+	}
+	return 0;
+}
+
+static int rw_check(u32 mask)
+{
+	pattern_write(0x12345678);
+	if (pattern_check(mask, 0x12345678))
+		return -EIO;
+	pattern_write(0x87654321);
+	return pattern_check(mask, 0x87654321);
+}
+
+/* Longest contiguous passing interval, including a run at the last sample. */
+static unsigned int longest_run(u64 bits, unsigned int count, unsigned int *mid)
+{
+	unsigned int i, start = 0, best = 0, width;
+
+	for (i = 0; i <= count; i++) {
+		if (i < count && (bits & (1ULL << i)))
+			continue;
+		width = i - start;
+		if (width > best) {
+			best = width;
+			*mid = start + (width - 1) / 2;
+		}
+		start = i + 1;
+	}
+	return best;
+}
+
+/* Choose the center of an all-pass rectangle, not a single lucky sample. */
+static int read_eye(struct t153_ddr_state *s, unsigned int lane)
+{
+	u64 eye[31], common;
+	unsigned int v, d, lo, hi, mid = 0, width, height, margin, score;
+	unsigned int best = 0, best_v = 0, best_d = 0;
+	u32 mask = 0x00ff00ffU << (lane * 8);
+
+	for (v = 0; v < 31; v++) {
+		s->vref[lane] = 4 + 4 * v;
+		set_read_vref(s);
+		eye[v] = 0;
+		for (d = 0; d < 32; d++) {
+			s->rd[lane] = d * 2;
+			set_delays(s);
+			if (!pattern_check(mask, 0))
+				eye[v] |= 1ULL << d;
+		}
+	}
+	for (lo = 0; lo < 31; lo++) {
+		common = ~0ULL;
+		for (hi = lo; hi < 31; hi++) {
+			common &= eye[hi];
+			width = longest_run(common, 32, &mid);
+			height = hi - lo + 1;
+			if (width < 4 || height < 3)
+				continue;
+			margin = width * 2 < height * 4 ? width * 2 : height * 4;
+			score = margin * 10000 + width * height;
+			if (score > best) {
+				best = score;
+				best_v = (lo + hi) / 2;
+				best_d = mid;
+			}
+		}
+	}
+	if (!best) {
+		printf("DDR read eye missing/narrow on lane %u\n", lane);
+		return -EIO;
+	}
+	s->vref[lane] = 4 + 4 * best_v;
+	s->rd[lane] = 2 * best_d;
+	set_read_vref(s);
+	set_delays(s);
+	printf("DDR lane %u: read Vref=%u delay=%u\n",
+	       lane, s->vref[lane], s->rd[lane]);
+	return pattern_check(mask, 0);
+}
+
+static int write_eye(struct t153_ddr_state *s)
+{
+	u64 eye[26][2], common[2];
+	unsigned int v, d, lane, lo, hi, width[2], mid[2] = { 0, 0 };
+	unsigned int height, narrow, margin, score, best = 0, best_v = 0;
+	unsigned int best_d[2] = { 0, 0 };
+	u8 saved[2] = { s->wr[0], s->wr[1] };
+	u16 mr6 = s->mr[6] & ~0x3f;
+
+	/* DDR4 write Vref is rank-wide, so require a shared window for both lanes. */
+	for (v = 0; v < 26; v++) {
+		if (set_write_vref(mr6 | v * 2))
+			return -ETIMEDOUT;
+		for (lane = 0; lane < 2; lane++) {
+			eye[v][lane] = 0;
+			for (d = 0; d < 57; d++) {
+				s->wr[lane] = 64 + 2 * d;
+				set_delays(s);
+				if (!rw_check(0x00ff00ffU << (lane * 8)))
+					eye[v][lane] |= 1ULL << d;
+			}
+			s->wr[lane] = saved[lane];
+			set_delays(s);
+		}
+	}
+	for (lo = 0; lo < 26; lo++) {
+		common[0] = common[1] = ~0ULL;
+		for (hi = lo; hi < 26; hi++) {
+			for (lane = 0; lane < 2; lane++) {
+				common[lane] &= eye[hi][lane];
+				width[lane] = longest_run(common[lane], 57, &mid[lane]);
+			}
+			narrow = width[0] < width[1] ? width[0] : width[1];
+			height = hi - lo + 1;
+			if (narrow < 4 || height < 3)
+				continue;
+			margin = narrow < height ? narrow : height;
+			score = margin * 10000 + narrow * height;
+			if (score > best) {
+				best = score;
+				best_v = (lo + hi) / 2;
+				best_d[0] = mid[0];
+				best_d[1] = mid[1];
+			}
+		}
+	}
+	if (!best) {
+		puts("DDR write eye missing/narrow across the two lanes\n");
+		return -EIO;
+	}
+	s->mr[6] = mr6 | best_v * 2;
+	for (lane = 0; lane < 2; lane++)
+		s->wr[lane] = 64 + best_d[lane] * 2;
+	if (set_write_vref(s->mr[6]))
+		return -ETIMEDOUT;
+	set_delays(s);
+	printf("DDR write Vref=%u delays=%u,%u\n",
+	       s->mr[6] & 0x3f, s->wr[0], s->wr[1]);
+	return rw_check(~0U);
+}
+
+static int bit_deskew(struct t153_ddr_state *s, int write)
+{
+	u64 pass;
+	u8 *skew = write ? s->wdq : s->rdq;
+	unsigned int bit, delay, mid = 0, width;
+	u32 mask;
+
+	if (!write) {
+		pattern_write(0);
+		if (pattern_check(~0U, 0))
+			return -EIO;
+	}
+	for (bit = 0; bit < 16; bit++) {
+		pass = 0;
+		mask = BIT(bit) | BIT(bit + 16);
+		for (delay = 0; delay < 64; delay++) {
+			skew[bit] = delay;
+			set_delays(s);
+			if (!(write ? rw_check(mask) : pattern_check(mask, 0)))
+				pass |= 1ULL << delay;
+		}
+		width = longest_run(pass, 64, &mid);
+		if (width < 6) {
+			printf("DDR %s DQ%u eye too narrow: %u taps\n",
+			       write ? "write" : "read", bit, width);
+			return -EIO;
+		}
+		skew[bit] = mid;
+		set_delays(s);
+	}
+	return write ? rw_check(~0U) : pattern_check(~0U, 0);
+}
+
+static int memory_verify(void)
+{
+	unsigned int bank, i, pass;
+	unsigned long b;
+	u32 expected;
+
+	/* Address-line alias check covers the configured physical geometry. */
+	writel(0x12345678, TEST0);
+	for (i = 2; i <= T153_DDR_LAST_ADDRESS_BIT; i++)
+		writel(0xa5a50000 | i, TEST0 + (1UL << i));
+	dsb();
+	if (readl(TEST0) != 0x12345678)
+		return -EIO;
+	for (i = 2; i <= T153_DDR_LAST_ADDRESS_BIT; i++)
+		if (readl(TEST0 + (1UL << i)) != (0xa5a50000 | i))
+			return -EIO;
+	/* Walking-one/zero patterns plus address-dependent data, in every 64 MiB. */
+	for (bank = 0; bank < T153_DDR_SIZE_MIB / 64; bank++) {
+		b = TEST0 + bank * 0x04000000UL + 0x10000;
+		for (pass = 0; pass < 4; pass++) {
+			for (i = 0; i < 16384; i++) {
+				expected = pass < 2 ? BIT(i & 31) : pattern(i, b);
+				writel(pass & 1 ? ~expected : expected, b + i * 4);
+			}
+			dsb();
+			for (i = 0; i < 16384; i++) {
+				expected = pass < 2 ? BIT(i & 31) : pattern(i, b);
+				if (pass & 1)
+					expected = ~expected;
+				if (readl(b + i * 4) != expected) {
+					printf("DDR memory mismatch at %08lx\n", b + i * 4);
+					return -EIO;
+				}
+			}
+		}
+	}
+	return 0;
+}
+
+int t153_ddr_init(void)
+{
+	struct t153_ddr_state s;
+	unsigned int delay;
+	int ret;
+
+	default_state(&s);
+	/* Board-specific controller-access setup; supply voltage is fixed by board. */
+	update(0x03000160, ~2U, 0);
+	writel(0x19220000, 0x03000188);
+	update(0x07010254, ~0U, 1);
+	udelay(10);
+	printf("DDR4 source init: %u MiB physical x16; bootstrap 480 MHz\n",
+	       T153_DDR_SIZE_MIB);
+	s.mhz = 480;
+	s.ac = 0x20;
+	for (delay = 0x16; delay <= 0x32; delay += 4) {
+		s.rd[0] = s.rd[1] = delay;
+		ret = core_init(&s);
+		if (ret == -ETIMEDOUT)
+			return ret;
+		if (!ret && !rw_check(~0U))
+			break;
+	}
+	if (delay > 0x32) {
+		puts("DDR low-frequency bootstrap failed\n");
+		return -EIO;
+	}
+	pattern_write(0);
+	default_state(&s);
+	puts("DDR4: 933 MHz read eye and Vref training\n");
+	ret = core_init(&s);
+	if (ret)
+		return ret;
+	if (read_eye(&s, 0) || read_eye(&s, 1))
+		return -EIO;
+	puts("DDR4: write eye and Vref training\n");
+	ret = write_eye(&s);
+	if (ret)
+		return ret;
+	puts("DDR4: per-bit read/write deskew\n");
+	if (bit_deskew(&s, 0) || bit_deskew(&s, 1))
+		return -EIO;
+	/* Reapply the trained state, rerun RXEN, and reject any final mismatch. */
+	ret = core_init(&s);
+	if (ret)
+		return ret;
+	puts("DDR4: geometry and memory checks\n");
+	ret = memory_verify();
+	if (ret)
+		return ret;
+	puts("DDR4: source initialization and memory checks passed\n");
+	return 0;
+}
diff --git a/package/boot/uboot-t153/files/board/dshanpi/t153/ddr.h b/package/boot/uboot-t153/files/board/dshanpi/t153/ddr.h
new file mode 100644
--- /dev/null
+++ b/package/boot/uboot-t153/files/board/dshanpi/t153/ddr.h
@@ -0,0 +1,24 @@
+/* SPDX-License-Identifier: GPL-2.0+ */
+#ifndef T153_DDR_H
+#define T153_DDR_H
+/* Single rank, x16, 10 columns, 4 banks, 2 BG; 15 or 16 row bits.
+ * Physical geometry is independent of the intentionally capped Linux RAM.
+ */
+#ifndef CONFIG_T153_DDR_SIZE_MIB
+#define CONFIG_T153_DDR_SIZE_MIB 512
+#endif
+#if CONFIG_T153_DDR_SIZE_MIB != 512 && CONFIG_T153_DDR_SIZE_MIB != 1024
+#error "T153 DDR4 supports only the verified 512/1024 MiB geometries"
+#endif
+#define T153_DDR_SIZE_MIB CONFIG_T153_DDR_SIZE_MIB
+#define T153_DDR_SIZE_BYTES (T153_DDR_SIZE_MIB * 1024UL * 1024UL)
+#define T153_DDR_LAST_ADDRESS_BIT (T153_DDR_SIZE_MIB == 1024 ? 29 : 28)
+struct t153_ddr_state {
+	unsigned int mhz;
+	unsigned short mr[7];
+	unsigned char rdq[16], wdq[16];
+	unsigned char rd[2], wr[2], rxen[2], vref[2];
+	unsigned char ac, wdqs;
+};
+int t153_ddr_init(void);
+#endif
diff --git a/package/boot/uboot-t153/files/board/dshanpi/t153/fel-request.c b/package/boot/uboot-t153/files/board/dshanpi/t153/fel-request.c
new file mode 100644
--- /dev/null
+++ b/package/boot/uboot-t153/files/board/dshanpi/t153/fel-request.c
@@ -0,0 +1,45 @@
+// SPDX-License-Identifier: GPL-2.0+
+/* Consume the vendor RTC EFEX request before DDR, from cold SD/eMMC only. */
+#ifndef T153_FEL_REQUEST_HOST_TEST
+#include <config.h>
+#include <stdio.h>
+#include <linux/string.h>
+#include <hang.h>
+#include <sunxi_image.h>
+#include <asm/io.h>
+#include <asm/barriers.h>
+#endif
+
+#define T153_RTC_EFEX_FLAG ((void *)0x07090108)
+#define T153_EFEX_MAGIC 0x5aa5a55a
+#define T153_EFEX_CLEAR_POLLS 1000
+
+extern void t153_enter_fel_fresh(void) __attribute__((noreturn));
+
+void t153_handle_fel_request(void)
+{
+	struct boot_file_head *head = (void *)0x40000;
+	unsigned int poll;
+	u8 media;
+
+	/* The eGON.FEL USB loader must retain its saved SP/LR return path. */
+	if (memcmp(head->magic, BOOT0_MAGIC, 8))
+		return;
+	media = readb(&head->boot_media);
+	if (media != 0 && media != 2)
+		return;
+	if (readl(T153_RTC_EFEX_FLAG) != T153_EFEX_MAGIC)
+		return;
+
+	for (poll = 0; poll < T153_EFEX_CLEAR_POLLS; ++poll) {
+		writel(0, T153_RTC_EFEX_FLAG);
+		dsb();
+		isb();
+		if (!readl(T153_RTC_EFEX_FLAG)) {
+			puts("RTC EFEX request cleared; entering BootROM FEL\n");
+			t153_enter_fel_fresh();
+		}
+	}
+	puts("RTC EFEX request could not be cleared; stopping in SRAM\n");
+	hang();
+}
diff --git a/package/boot/uboot-t153/files/board/dshanpi/t153/fel.S b/package/boot/uboot-t153/files/board/dshanpi/t153/fel.S
new file mode 100644
--- /dev/null
+++ b/package/boot/uboot-t153/files/board/dshanpi/t153/fel.S
@@ -0,0 +1,75 @@
+/* SPDX-License-Identifier: GPL-2.0+ */
+/* Based on upstream ARMv7 sunxi/fel_utils.S, Copyright 2015 Google, Inc. */
+#include <linux/linkage.h>
+ENTRY(save_boot_params)
+	ldr r0, =t153_fel_context
+	str sp, [r0]
+	str lr, [r0, #4]
+	mrs lr, cpsr
+	str lr, [r0, #8]
+	mrc p15, 0, lr, c1, c0, 0
+	str lr, [r0, #12]
+	mrc p15, 0, lr, c12, c0, 0
+	str lr, [r0, #16]
+	b save_boot_params_ret
+ENDPROC(save_boot_params)
+
+ENTRY(t153_return_to_fel)
+	ldr r0, =t153_fel_context
+	ldr sp, [r0]
+	ldr lr, [r0, #4]
+	dsb sy
+	ldr r1, [r0, #16]
+	mcr p15, 0, r1, c12, c0, 0
+	isb sy
+	ldr r1, [r0, #12]
+	mcr p15, 0, r1, c1, c0, 0
+	isb sy
+	ldr r1, [r0, #8]
+	msr cpsr, r1
+	bx lr
+ENDPROC(t153_return_to_fel)
+
+/*
+ * Fresh BootROM FEL entry, only called before DDR after a cold-media EFEX
+ * request. This is NOT the USB loader's saved-SP/LR return route above.
+ * T153 vendor boot0 uses ARM physical 0x20 after disabling I/C/A/M and
+ * waiting 100 us / 10 ms using the 24 MHz architectural counter.
+ */
+ENTRY(t153_enter_fel_fresh)
+	cpsid if
+	mrc p15, 0, r4, c1, c0, 0
+	mrrc p15, 0, r0, r1, c14
+	ldr r5, =2400
+1:
+	mrrc p15, 0, r2, r3, c14
+	sub r2, r2, r0
+	cmp r2, r5
+	blo 1b
+	bic r4, r4, #0x1000
+	bic r4, r4, #7
+	mcr p15, 0, r4, c1, c0, 0
+	isb sy
+	mov r2, #0
+	mcr p15, 0, r2, c7, c5, 0
+	mcr p15, 0, r2, c7, c5, 6
+	dsb sy
+	isb sy
+	mrrc p15, 0, r0, r1, c14
+	ldr r5, =240000
+2:
+	mrrc p15, 0, r2, r3, c14
+	sub r2, r2, r0
+	cmp r2, r5
+	blo 2b
+	/* Unlike vendor boot0, upstream start.S has changed VBAR to _start. */
+	ldr r0, =t153_fel_context
+	ldr r1, [r0, #16]
+	dsb sy
+	mcr p15, 0, r1, c12, c0, 0
+	isb sy
+	mov r0, #0x20
+	mov r2, #0
+	mcr p15, 0, r2, c7, c5, 6
+	bx r0
+ENDPROC(t153_enter_fel_fresh)
diff --git a/package/boot/uboot-t153/files/board/dshanpi/t153/mmc.c b/package/boot/uboot-t153/files/board/dshanpi/t153/mmc.c
new file mode 100644
--- /dev/null
+++ b/package/boot/uboot-t153/files/board/dshanpi/t153/mmc.c
@@ -0,0 +1,471 @@
+// SPDX-License-Identifier: GPL-2.0+
+/*
+ * PIO command engine adapted from U-Boot 2026.07 drivers/mmc/sunxi_mmc.c.
+ * (C) Copyright 2007-2011 Allwinner Technology Co., Ltd.
+ * Aaron <leafy.myeh@allwinnertech.com>
+ * T153 platform glue: oscillator only, SDR <= 12 MHz, no media writes.
+ */
+#include <dm.h>
+#include <errno.h>
+#include <log.h>
+#include <mmc.h>
+#include <time.h>
+#include <asm/io.h>
+#include <linux/delay.h>
+#include <linux/bitops.h>
+#include <linux/iopoll.h>
+#include <linux/build_bug.h>
+#include "sunxi_mmc.h"
+#include "t153.h"
+
+struct sunxi_mmc_plat {
+	struct mmc_config cfg;
+	struct mmc mmc;
+};
+
+struct sunxi_mmc_priv {
+	unsigned int mmc_no;
+	u32 *mclkreg;
+	unsigned int fatal_err;
+	struct sunxi_mmc *reg;
+};
+
+static int mmc_set_mod_clk(struct sunxi_mmc_priv *priv, unsigned int hz)
+{
+	unsigned int div;
+
+	if (!hz || hz > 12000000)
+		return -EINVAL;
+	/* 24 MHz oscillator, 2x SDR clock; 5-bit linear M divider. */
+	div = DIV_ROUND_UP(24000000U, hz * 2);
+	if (!div || div > 32)
+		return -EINVAL;
+	clrbits_le32(priv->mclkreg, BIT(31));
+	writel(BIT(31) | (div - 1), priv->mclkreg);
+	return 0;
+}
+
+static int mmc_update_clk(struct sunxi_mmc_priv *priv)
+{
+	unsigned int cmd;
+	unsigned timeout_msecs = 2000;
+	unsigned long start = get_timer(0);
+
+	cmd = SUNXI_MMC_CMD_START |
+	      SUNXI_MMC_CMD_UPCLK_ONLY |
+	      SUNXI_MMC_CMD_WAIT_PRE_OVER;
+
+	writel(cmd, &priv->reg->cmd);
+	while (readl(&priv->reg->cmd) & SUNXI_MMC_CMD_START) {
+		if (get_timer(start) > timeout_msecs)
+			return -1;
+	}
+
+	/* clock update sets various irq status bits, clear these */
+	writel(readl(&priv->reg->rint), &priv->reg->rint);
+
+	return 0;
+}
+
+static int mmc_config_clock(struct sunxi_mmc_priv *priv, struct mmc *mmc)
+{
+	unsigned rval = readl(&priv->reg->clkcr);
+
+	/* Disable Clock */
+	rval &= ~SUNXI_MMC_CLK_ENABLE;
+	writel(rval, &priv->reg->clkcr);
+	if (mmc_update_clk(priv))
+		return -1;
+
+	/* Set mod_clk to new rate */
+	if (mmc_set_mod_clk(priv, mmc->clock))
+		return -1;
+
+	/* Clear internal divider */
+	rval &= ~SUNXI_MMC_CLK_DIVIDER_MASK;
+	writel(rval, &priv->reg->clkcr);
+
+	/* T153 new timing uses a 2x module clock. */
+	setbits_le32(&priv->reg->ntsr, SUNXI_MMC_NTSR_MODE_SEL_NEW);
+	/* 180-degree drive phase; TM1 on SD, TM4 on eMMC. */
+	clrsetbits_le32((void *)priv->reg + 0x140, 3 << 16, 3 << 16);
+	if (priv->mmc_no == 0)
+		clrsetbits_le32(&priv->reg->ntsr, 3 << 4, 1 << 4);
+	else {
+		writel(SUNXI_MMC_CAL_DL_SW_EN, &priv->reg->samp_dl);
+		setbits_le32((void *)priv->reg + 0x104, BIT(0));
+	}
+
+	/* Re-enable Clock */
+	rval |= SUNXI_MMC_CLK_ENABLE;
+	writel(rval, &priv->reg->clkcr);
+	if (mmc_update_clk(priv))
+		return -1;
+
+	return 0;
+}
+
+static int sunxi_mmc_set_ios_common(struct sunxi_mmc_priv *priv,
+				    struct mmc *mmc)
+{
+	debug("set ios: bus_width: %x, clock: %d\n",
+	      mmc->bus_width, mmc->clock);
+
+	/* Change clock first */
+	if (mmc->clock && mmc_config_clock(priv, mmc) != 0) {
+		priv->fatal_err = 1;
+		return -EINVAL;
+	}
+
+	/* Change bus width */
+	if (mmc->bus_width == 8)
+		writel(0x2, &priv->reg->width);
+	else if (mmc->bus_width == 4)
+		writel(0x1, &priv->reg->width);
+	else
+		writel(0x0, &priv->reg->width);
+
+	return 0;
+}
+
+static int mmc_trans_data_by_cpu(struct sunxi_mmc_priv *priv, struct mmc *mmc,
+				 struct mmc_data *data)
+{
+	const int reading = !!(data->flags & MMC_DATA_READ);
+	const uint32_t status_bit = reading ? SUNXI_MMC_STATUS_FIFO_EMPTY :
+					      SUNXI_MMC_STATUS_FIFO_FULL;
+	unsigned i;
+	unsigned *buff = (unsigned int *)(reading ? data->dest : data->src);
+	unsigned word_cnt = (data->blocksize * data->blocks) >> 2;
+	unsigned timeout_msecs = word_cnt >> 6;
+	uint32_t status;
+	unsigned long  start;
+
+	if (timeout_msecs < 2000)
+		timeout_msecs = 2000;
+
+	/* Always read / write data through the CPU */
+	setbits_le32(&priv->reg->gctrl, SUNXI_MMC_GCTRL_ACCESS_BY_AHB);
+
+	start = get_timer(0);
+
+	for (i = 0; i < word_cnt;) {
+		unsigned int in_fifo;
+
+		if (get_timer(start) > timeout_msecs ||
+		    (readl(&priv->reg->rint) & SUNXI_MMC_RINT_INTERRUPT_ERROR_BIT))
+			return -ETIMEDOUT;
+
+		while ((status = readl(&priv->reg->status)) & status_bit) {
+			if (get_timer(start) > timeout_msecs)
+				return -1;
+		}
+
+		/*
+		 * For writing we do not easily know the FIFO size, so have
+		 * to check the FIFO status after every word written.
+		 * TODO: For optimisation we could work out a minimum FIFO
+		 * size across all SoCs, and use that together with the current
+		 * fill level to write chunks of words.
+		 */
+		if (!reading) {
+			writel(buff[i++], &priv->reg->fifo);
+			continue;
+		}
+
+		/*
+		 * The status register holds the current FIFO level, so we
+		 * can be sure to collect as many words from the FIFO
+		 * register without checking the status register after every
+		 * read. That saves half of the costly MMIO reads, effectively
+		 * doubling the read performance.
+		 * Some SoCs (A20) report a level of 0 if the FIFO is
+		 * completely full (value masked out?). Use a safe minimal
+		 * FIFO size in this case.
+		 */
+		in_fifo = SUNXI_MMC_STATUS_FIFO_LEVEL(status);
+		if (in_fifo == 0 && (status & SUNXI_MMC_STATUS_FIFO_FULL))
+			in_fifo = 32;
+		for (; in_fifo > 0 && i < word_cnt; in_fifo--)
+			buff[i++] = readl_relaxed(&priv->reg->fifo);
+		dmb();
+	}
+
+	return 0;
+}
+
+static int mmc_rint_wait(struct sunxi_mmc_priv *priv, struct mmc *mmc,
+			 uint timeout_msecs, uint done_bit, const char *what)
+{
+	unsigned int status;
+	unsigned long start = get_timer(0);
+
+	do {
+		status = readl(&priv->reg->rint);
+		if ((get_timer(start) > timeout_msecs) ||
+		    (status & SUNXI_MMC_RINT_INTERRUPT_ERROR_BIT)) {
+			debug("%s timeout %x\n", what,
+			      status & SUNXI_MMC_RINT_INTERRUPT_ERROR_BIT);
+			return -ETIMEDOUT;
+		}
+	} while (!(status & done_bit));
+
+	return 0;
+}
+
+static int sunxi_mmc_send_cmd_common(struct sunxi_mmc_priv *priv,
+				     struct mmc *mmc, struct mmc_cmd *cmd,
+				     struct mmc_data *data)
+{
+	unsigned int cmdval = SUNXI_MMC_CMD_START;
+	unsigned int timeout_msecs;
+	int error = 0;
+	unsigned int status = 0;
+	unsigned int bytecnt = 0;
+
+	if (priv->fatal_err)
+		return -EIO;
+	if (data && (data->flags & MMC_DATA_WRITE))
+		return -EROFS;
+	if (data && (!data->blocks || !data->blocksize ||
+		     (data->blocksize & 3) || data->blocksize > 512 ||
+		     data->blocks > CONFIG_SYS_MMC_MAX_BLK_COUNT))
+		return -EINVAL;
+	if (cmd->resp_type & MMC_RSP_BUSY)
+		debug("mmc cmd %d check rsp busy\n", cmd->cmdidx);
+	if (cmd->cmdidx == 12)
+		return 0;
+
+	if (!cmd->cmdidx)
+		cmdval |= SUNXI_MMC_CMD_SEND_INIT_SEQ;
+	if (cmd->resp_type & MMC_RSP_PRESENT)
+		cmdval |= SUNXI_MMC_CMD_RESP_EXPIRE;
+	if (cmd->resp_type & MMC_RSP_136)
+		cmdval |= SUNXI_MMC_CMD_LONG_RESPONSE;
+	if (cmd->resp_type & MMC_RSP_CRC)
+		cmdval |= SUNXI_MMC_CMD_CHK_RESPONSE_CRC;
+
+	if (data) {
+		if ((u32)(long)data->dest & 0x3) {
+			error = -1;
+			goto out;
+		}
+
+		cmdval |= SUNXI_MMC_CMD_DATA_EXPIRE|SUNXI_MMC_CMD_WAIT_PRE_OVER;
+		if (data->flags & MMC_DATA_WRITE)
+			cmdval |= SUNXI_MMC_CMD_WRITE;
+		if (data->blocks > 1)
+			cmdval |= SUNXI_MMC_CMD_AUTO_STOP;
+		writel(data->blocksize, &priv->reg->blksz);
+		writel(data->blocks * data->blocksize, &priv->reg->bytecnt);
+	}
+
+	debug("mmc %d, cmd %d(0x%08x), arg 0x%08x\n", priv->mmc_no,
+	      cmd->cmdidx, cmdval | cmd->cmdidx, cmd->cmdarg);
+	writel(cmd->cmdarg, &priv->reg->arg);
+
+	if (!data)
+		writel(cmdval | cmd->cmdidx, &priv->reg->cmd);
+
+	/*
+	 * transfer data and check status
+	 * STATREG[2] : FIFO empty
+	 * STATREG[3] : FIFO full
+	 */
+	if (data) {
+		int ret = 0;
+
+		bytecnt = data->blocksize * data->blocks;
+		debug("trans data %d bytes\n", bytecnt);
+		writel(cmdval | cmd->cmdidx, &priv->reg->cmd);
+		ret = mmc_trans_data_by_cpu(priv, mmc, data);
+		if (ret) {
+			error = readl(&priv->reg->rint) &
+				SUNXI_MMC_RINT_INTERRUPT_ERROR_BIT;
+			error = -ETIMEDOUT;
+			goto out;
+		}
+	}
+
+	error = mmc_rint_wait(priv, mmc, 1000, SUNXI_MMC_RINT_COMMAND_DONE,
+			      "cmd");
+	if (error)
+		goto out;
+
+	if (data) {
+		timeout_msecs = 120;
+		debug("cacl timeout %x msec\n", timeout_msecs);
+		error = mmc_rint_wait(priv, mmc, timeout_msecs,
+				      data->blocks > 1 ?
+				      SUNXI_MMC_RINT_AUTO_COMMAND_DONE :
+				      SUNXI_MMC_RINT_DATA_OVER,
+				      "data");
+		if (error)
+			goto out;
+	}
+
+	if (cmd->resp_type & MMC_RSP_BUSY) {
+		unsigned long start = get_timer(0);
+		timeout_msecs = 2000;
+
+		do {
+			status = readl(&priv->reg->status);
+			if (get_timer(start) > timeout_msecs) {
+				debug("busy timeout\n");
+				error = -ETIMEDOUT;
+				goto out;
+			}
+		} while (status & SUNXI_MMC_STATUS_CARD_DATA_BUSY);
+	}
+
+	if (cmd->resp_type & MMC_RSP_136) {
+		cmd->response[0] = readl(&priv->reg->resp3);
+		cmd->response[1] = readl(&priv->reg->resp2);
+		cmd->response[2] = readl(&priv->reg->resp1);
+		cmd->response[3] = readl(&priv->reg->resp0);
+		debug("mmc resp 0x%08x 0x%08x 0x%08x 0x%08x\n",
+		      cmd->response[3], cmd->response[2],
+		      cmd->response[1], cmd->response[0]);
+	} else {
+		cmd->response[0] = readl(&priv->reg->resp0);
+		debug("mmc resp 0x%08x\n", cmd->response[0]);
+	}
+out:
+	if (error < 0) {
+		writel(SUNXI_MMC_GCTRL_RESET, &priv->reg->gctrl);
+		mmc_update_clk(priv);
+	}
+	writel(0xffffffff, &priv->reg->rint);
+	writel(readl(&priv->reg->gctrl) | SUNXI_MMC_GCTRL_FIFO_RESET,
+	       &priv->reg->gctrl);
+
+	return error;
+}
+
+static int sunxi_mmc_reset(void *regs)
+{
+	u32 val;
+	int ret;
+	/* Reset controller */
+	writel(SUNXI_MMC_GCTRL_RESET, regs + SUNXI_MMC_GCTRL);
+	ret = readl_poll_timeout(regs + SUNXI_MMC_GCTRL, val,
+				 !(val & SUNXI_MMC_GCTRL_RESET), 10000);
+	if (ret)
+		return ret;
+	writel(0xffffffff, regs + 0x08); /* response/data timeout */
+	writel(0, regs + 0x30); /* interrupts are polled */
+	writel(0xffffffff, regs + 0x38);
+
+	{
+		/* Reset card */
+		writel(SUNXI_MMC_HWRST_ASSERT, regs + SUNXI_MMC_HWRST);
+		udelay(10);
+		writel(SUNXI_MMC_HWRST_DEASSERT, regs + SUNXI_MMC_HWRST);
+		udelay(300);
+
+		/* Setup FIFO R/W threshold. Needed on H616. */
+		writel(SUNXI_MMC_THLDC_READ_THLD(512) |
+		       SUNXI_MMC_THLDC_WRITE_EN |
+		       SUNXI_MMC_THLDC_READ_EN, regs + SUNXI_MMC_THLDC);
+	}
+	return 0;
+}
+
+
+static int t153_mmc_set_ios(struct udevice *dev)
+{
+	struct sunxi_mmc_plat *plat = dev_get_plat(dev);
+	return sunxi_mmc_set_ios_common(dev_get_priv(dev), &plat->mmc);
+}
+
+static int t153_mmc_send_cmd(struct udevice *dev, struct mmc_cmd *cmd,
+			   struct mmc_data *data)
+{
+	struct sunxi_mmc_plat *plat = dev_get_plat(dev);
+	return sunxi_mmc_send_cmd_common(dev_get_priv(dev), &plat->mmc, cmd, data);
+}
+
+static int t153_mmc_getcd(struct udevice *dev)
+{
+	/* SD has no reliable card-detect wiring in the initial board port. */
+	return 1;
+}
+
+static const struct dm_mmc_ops t153_mmc_ops = {
+	.send_cmd = t153_mmc_send_cmd,
+	.set_ios = t153_mmc_set_ios,
+	.get_cd = t153_mmc_getcd,
+};
+
+static int t153_mmc_probe(struct udevice *dev)
+{
+	struct mmc_uclass_priv *upriv = dev_get_uclass_priv(dev);
+	struct sunxi_mmc_plat *plat = dev_get_plat(dev);
+	struct sunxi_mmc_priv *priv = dev_get_priv(dev);
+	struct mmc_config *cfg = &plat->cfg;
+	void *ccu = (void *)0x02002000;
+	unsigned int pin;
+	int ret;
+
+	BUILD_BUG_ON(offsetof(struct sunxi_mmc, fifo) != 0x200);
+	BUILD_BUG_ON(offsetof(struct sunxi_mmc, samp_dl) != 0x144);
+	priv->reg = dev_read_addr_ptr(dev);
+	if ((uintptr_t)priv->reg == 0x04020000)
+		priv->mmc_no = 0;
+	else if ((uintptr_t)priv->reg == 0x04022000)
+		priv->mmc_no = 2;
+	else
+		return -EINVAL;
+
+	cfg->name = dev->name;
+	cfg->voltages = MMC_VDD_32_33 | MMC_VDD_33_34;
+	cfg->b_max = CONFIG_SYS_MMC_MAX_BLK_COUNT;
+	cfg->f_min = 400000;
+	cfg->f_max = 12000000;
+	ret = mmc_of_parse(dev, cfg);
+	if (ret)
+		return ret;
+
+	if (priv->mmc_no == 0) {
+		for (pin = 0; pin < 6; pin++)
+			t153_pin(5, pin, 1);
+	} else {
+		for (pin = 0; pin < 10; pin++)
+			t153_pin(2, pin, 1);
+		t153_pin(2, 11, 1); /* eMMC reset; PC10 data strobe is not used. */
+	}
+
+	priv->mclkreg = ccu + 0xd00 + priv->mmc_no * 0x10;
+	setbits_le32(ccu + 0x5c0, BIT(5 + priv->mmc_no));
+	setbits_le32(ccu + 0xd0c + priv->mmc_no * 0x10, BIT(0) | BIT(16));
+	ret = mmc_set_mod_clk(priv, 400000);
+	if (ret)
+		return ret;
+	ret = sunxi_mmc_reset(priv->reg);
+	if (ret)
+		return ret;
+	upriv->mmc = &plat->mmc;
+	return 0;
+}
+
+static int t153_mmc_bind(struct udevice *dev)
+{
+	struct sunxi_mmc_plat *plat = dev_get_plat(dev);
+	return mmc_bind(dev, &plat->mmc, &plat->cfg);
+}
+
+static const struct udevice_id t153_mmc_ids[] = {
+	{ .compatible = "dshanpi,t153-ram-mmc" },
+	{ }
+};
+
+U_BOOT_DRIVER(t153_ram_mmc) = {
+	.name = "t153_ram_mmc",
+	.id = UCLASS_MMC,
+	.of_match = t153_mmc_ids,
+	.bind = t153_mmc_bind,
+	.probe = t153_mmc_probe,
+	.ops = &t153_mmc_ops,
+	.plat_auto = sizeof(struct sunxi_mmc_plat),
+	.priv_auto = sizeof(struct sunxi_mmc_priv),
+};
diff --git a/package/boot/uboot-t153/files/board/dshanpi/t153/psci-entry-t153.S b/package/boot/uboot-t153/files/board/dshanpi/t153/psci-entry-t153.S
new file mode 100644
--- /dev/null
+++ b/package/boot/uboot-t153/files/board/dshanpi/t153/psci-entry-t153.S
@@ -0,0 +1,29 @@
+/* SPDX-License-Identifier: GPL-2.0+ */
+/* Only linked by the opt-in T153 source-1g-smp configuration. */
+#include <linux/linkage.h>
+
+	.pushsection ._secure.text, "ax"
+	.arm
+	.align 5
+ENTRY(t153_psci_cpu_entry)
+	/* The T153 Boot ROM is expected to enter secure ARM state after reset. */
+	cpsid if
+	mrc p15, 0, r0, c1, c0, 0
+	/* Fail closed if unexpectedly handed a live MMU or data cache. */
+	tst r0, #5
+	bne 1f
+	/* Match the T153 sample's low-vector state; generic PSCI sets MVBAR. */
+	bic r0, r0, #(1 << 13)
+	mcr p15, 0, r0, c1, c0, 0
+	mov r0, #0
+	mcr p15, 0, r0, c7, c5, 0
+	mcr p15, 0, r0, c7, c5, 6
+	dsb
+	isb
+	/* Reuse ACTLR.SMP, GIC, timer, secure stack and NS transition code. */
+	b psci_cpu_entry
+1:
+	wfi
+	b 1b
+ENDPROC(t153_psci_cpu_entry)
+	.popsection
diff --git a/package/boot/uboot-t153/files/board/dshanpi/t153/psci-t153.c b/package/boot/uboot-t153/files/board/dshanpi/t153/psci-t153.c
new file mode 100644
--- /dev/null
+++ b/package/boot/uboot-t153/files/board/dshanpi/t153/psci-t153.c
@@ -0,0 +1,191 @@
+// SPDX-License-Identifier: GPL-2.0+
+/*
+ * T153 cold CPU_ON for the opt-in source-1g-smp U-Boot target.
+ * CPU_OFF/suspend are deliberately not advertised; hardware qualification
+ * is recorded separately from compilation.
+ *
+ * T153 register sequence derived from the GPL-2.0+ SyterKit SMP sample:
+ * https://github.com/YuzukiHD/SyterKit/blob/
+ * 7f539e17762639589897db835e58dd638b2bea80/
+ * boards/tlt153-minievm/app_sram/smp/main.c
+ *
+ * No register sequences from A31/H3/R528 are used here. CPU_OFF and suspend
+ * remain unsupported: neither the sample nor the available T153 SDK sources
+ * establish their complete hardware sequence.
+ */
+#include <config.h>
+#include <asm/io.h>
+#include <asm/psci.h>
+#include <asm/secure.h>
+#include <asm/system.h>
+#include <linux/bitops.h>
+
+#if !defined(CONFIG_ARMV7_PSCI_0_1)
+#error "This unqualified CPU_ON-only candidate requires PSCI 0.1"
+#endif
+#if CONFIG_ARMV7_PSCI_NR_CPUS != 4
+#error "T153 cold CPU_ON candidate requires four PSCI contexts/stacks"
+#endif
+
+#define T153_CPU_SOFT_ENTRY(cpu) (0x07050070U + (cpu) * 4U)
+#define T153_CPU_PWR_STATUS(cpu) (0x07051050U + (cpu) * 4U)
+#define T153_CPU_CFG(cpu)        (0x07051070U + (cpu) * 4U)
+#define T153_CPU_HOTPLUG(cpu)    (0x07051080U + (cpu) * 4U)
+#define T153_CPUIDLE_ENABLE     0x07051100U
+#define T153_POWER_SW_DELAY     0x07051140U
+#define T153_F1F2_CONFIG_DELAY  0x07051144U
+#define T153_POWER_OFF          0xffU
+#define T153_WAKEUP_MASK        BIT(0)
+#define T153_CPU_IRQ_MASK       BIT(4)
+#define T153_HOTPLUG_REQ        BIT(16)
+#define T153_BOOT_POLL_COUNT    0x100000U
+
+enum t153_cpu_state {
+	T153_CPU_OFF = 0,
+	T153_CPU_STARTING,
+	T153_CPU_RELEASED,
+	T153_CPU_FAILED,
+};
+
+/* Secure monitor data must remain resident after ordinary U-Boot is gone. */
+/* Only CPU0 writes state; each secondary writes its own ready flag. */
+static volatile u32 t153_cpu_state[4] __secure_data = {
+	T153_CPU_RELEASED, T153_CPU_OFF, T153_CPU_OFF, T153_CPU_OFF,
+};
+static volatile u32 t153_cpu_ready[4] __secure_data = { 0, 0, 0, 0 };
+
+void t153_psci_cpu_entry(void);
+
+/* Bounded delay matching the sample's iteration-based delay, not microseconds. */
+static void __secure t153_delay(unsigned int count)
+{
+	while (count--)
+		asm volatile("nop" : : : "memory");
+}
+
+/*
+ * Generic armv7_init_nonsec() calls this exactly once on the boot CPU, before
+ * secure relocation. Do not put this global sequence in psci_arch_init():
+ * that hook runs again for each secondary's first non-secure entry.
+ *
+ * This operation enables the T153 CPUIDLE sequencer. Normal CPU0 WFI wakeup
+ * must therefore be part of qualification, not just secondary arrival.
+ */
+void psci_board_init(void)
+{
+	unsigned int cpu;
+
+	for (cpu = 0; cpu < 4; cpu++)
+		setbits_le32(T153_CPU_CFG(cpu), T153_CPU_IRQ_MASK);
+	writel(24, T153_F1F2_CONFIG_DELAY);
+	writel(24, T153_POWER_SW_DELAY);
+	writel(0x16aa0000, T153_CPUIDLE_ENABLE);
+	writel(0xaa160001, T153_CPUIDLE_ENABLE);
+	dsb();
+}
+
+/*
+ * The initial qualification supports CPU0 serially starting CPU1..CPU3.
+ * It does not advertise a general hotplug service or concurrent CPU_ON.
+ */
+int __secure psci_cpu_on(u32 function_id, u32 mpidr, u32 pc, u32 context_id)
+{
+	unsigned int cpu = mpidr;
+	unsigned int timeout;
+	u32 state;
+
+	(void)function_id;
+	if ((mpidr & ~3U) || !cpu || !pc || (pc & 3U))
+		return ARM_PSCI_RET_INVAL;
+	if (psci_get_cpu_id() != 0)
+		return ARM_PSCI_RET_DENIED;
+
+	state = t153_cpu_state[cpu];
+	if (state == T153_CPU_RELEASED)
+		return ARM_PSCI_RET_ALREADY_ON;
+	if (state == T153_CPU_STARTING)
+		return ARM_PSCI_RET_ON_PENDING;
+	if (state != T153_CPU_OFF)
+		return ARM_PSCI_RET_DENIED;
+
+	/* Preserve target/context in the generic resident secure context table. */
+	psci_save(cpu, pc, context_id);
+	writel((u32)t153_psci_cpu_entry, T153_CPU_SOFT_ENTRY(cpu));
+	t153_cpu_state[cpu] = T153_CPU_STARTING;
+	dsb();
+	setbits_le32(T153_CPU_HOTPLUG(cpu), T153_WAKEUP_MASK);
+
+	/* Source sample's precondition: the target is genuinely powered off. */
+	if ((readl(T153_CPU_PWR_STATUS(cpu)) & 0xffU) != T153_POWER_OFF) {
+		clrbits_le32(T153_CPU_HOTPLUG(cpu), T153_WAKEUP_MASK);
+		t153_cpu_state[cpu] = T153_CPU_FAILED;
+		dsb();
+		return ARM_PSCI_RET_DENIED;
+	}
+
+	t153_delay(1000);
+	setbits_le32(T153_CPU_HOTPLUG(cpu), T153_HOTPLUG_REQ);
+	dsb();
+
+	for (timeout = 0; timeout < T153_BOOT_POLL_COUNT; timeout++) {
+		if (!(readl(T153_CPU_HOTPLUG(cpu)) & T153_HOTPLUG_REQ) &&
+		    t153_cpu_ready[cpu]) {
+			/* Both hardware completion and execution of our stub observed. */
+			t153_cpu_state[cpu] = T153_CPU_RELEASED;
+			dsb();
+			asm volatile("sev" : : : "memory");
+			return ARM_PSCI_RET_SUCCESS;
+		}
+		t153_delay(100);
+	}
+
+	/* No undocumented cancel/reset/power-off writes on failure. */
+	t153_cpu_state[cpu] = T153_CPU_FAILED;
+	dsb();
+	asm volatile("sev" : : : "memory");
+	return ARM_PSCI_RET_INTERNAL_FAILURE;
+}
+
+/*
+ * Generic psci_cpu_entry calls this after secure stack/per-core GIC setup,
+ * but before it obtains the kernel PC/context and enters non-secure Linux.
+ */
+void __secure psci_arch_cpu_entry(void)
+{
+	u32 cpu = psci_get_cpu_id();
+
+	if (cpu == 0 || cpu >= 4)
+		goto parked;
+	clrbits_le32(T153_CPU_HOTPLUG(cpu), T153_WAKEUP_MASK);
+	if (t153_cpu_state[cpu] != T153_CPU_STARTING)
+		goto parked;
+
+	/* Never overwrite a concurrent CPU0 timeout/FAILED decision. */
+	t153_cpu_ready[cpu] = 1;
+	dsb();
+	while (t153_cpu_state[cpu] == T153_CPU_STARTING)
+		asm volatile("wfe" : : : "memory");
+	if (t153_cpu_state[cpu] == T153_CPU_RELEASED) {
+		dsb();
+		return;
+	}
+
+parked:
+	/* This is an error holding pen in reserved SRAM, NOT PSCI CPU_OFF. */
+	for (;;)
+		asm volatile("wfi" : : : "memory");
+}
+
+s32 __secure psci_cpu_off(void)
+{
+	return ARM_PSCI_RET_NI;
+}
+
+int __secure psci_cpu_suspend(u32 function_id, u32 state, u32 pc, u32 context)
+{
+	(void)function_id;
+	(void)state;
+	(void)pc;
+	(void)context;
+	return ARM_PSCI_RET_NI;
+}
diff --git a/package/boot/uboot-t153/files/board/dshanpi/t153/reset.c b/package/boot/uboot-t153/files/board/dshanpi/t153/reset.c
new file mode 100644
--- /dev/null
+++ b/package/boot/uboot-t153/files/board/dshanpi/t153/reset.c
@@ -0,0 +1,166 @@
+// SPDX-License-Identifier: GPL-2.0+
+/* T153 watchdog v2 reset and BootROM FEL request.
+ * Register layout, reset output mask and keys follow the T153 SDK
+ * sun8iw22p1.dtsi and sunxi_wdt.c. The RTC request follows rtc.c.
+ * No PLL, DDR, MMC, eMMC boot configuration or persistent data is changed.
+ */
+#include <config.h>
+#include <cpu_func.h>
+#include <hang.h>
+#include <irq_func.h>
+#include <stdio.h>
+#include <asm/barriers.h>
+#include <asm/io.h>
+#include <linux/delay.h>
+#include <linux/errno.h>
+#ifndef CONFIG_XPL_BUILD
+#include <command.h>
+#endif
+
+#define T153_RTC_FEL_REG		0x07090108UL
+#define T153_FEL_MAGIC		0x5aa5a55aU
+#define T153_WDT_BASE		0x02050000UL
+#define T153_WDT_CTRL		0x0c
+#define T153_WDT_CFG		0x10
+#define T153_WDT_MODE		0x14
+#define T153_WDT_OUT_CFG		0x18
+#define T153_WDT_KEY		0x16aa0000U
+#define T153_WDT_RELOAD		0x000014afU
+#define T153_WDT_OUT_MASK	0x00000fffU
+#define T153_WDT_OUT_RESET	0x0000003fU
+#define T153_WDT_RESET_MASK	0x00000003U
+#define T153_WDT_SYSTEM_RESET	0x00000001U
+#define T153_WDT_TIMEOUT_MASK	0x000000f0U
+#define T153_WDT_ENABLE		0x00000001U
+
+static int t153_rtc_store(u32 value)
+{
+	void __iomem *rtc = (void __iomem *)T153_RTC_FEL_REG;
+	unsigned int retry;
+
+	for (retry = 0; retry < 1000; retry++) {
+		writel(value, rtc);
+		dsb();
+		isb();
+		if (readl(rtc) == value)
+			return 0;
+		udelay(1);
+	}
+	return -ETIMEDOUT;
+}
+
+static int t153_clear_fel_request(void)
+{
+	/* This is one full RTC data word, not the index-6 bootmode flag. */
+	if (readl((void __iomem *)T153_RTC_FEL_REG) == T153_FEL_MAGIC)
+		return t153_rtc_store(0);
+	return 0;
+}
+
+static int t153_watchdog_prepare(void)
+{
+	void __iomem *wdt = (void __iomem *)T153_WDT_BASE;
+	u32 value;
+
+	/* The SDK node uses the fixed 24 MHz oscillator, without a CCU gate
+	 * or reset phandle; the SDK watchdog probe does not enable a clock.
+	 * Its probe first stops the watchdog before configuring it.
+	 */
+	writel(T153_WDT_KEY, wdt + T153_WDT_MODE);
+	value = readl(wdt + T153_WDT_OUT_CFG) & ~T153_WDT_OUT_MASK;
+	writel(value | T153_WDT_OUT_RESET | T153_WDT_KEY,
+	       wdt + T153_WDT_OUT_CFG);
+	value = readl(wdt + T153_WDT_CFG) & ~T153_WDT_RESET_MASK;
+	writel(value | T153_WDT_SYSTEM_RESET | T153_WDT_KEY,
+	       wdt + T153_WDT_CFG);
+	dsb();
+	if ((readl(wdt + T153_WDT_OUT_CFG) & T153_WDT_OUT_MASK) !=
+	    T153_WDT_OUT_RESET ||
+	    (readl(wdt + T153_WDT_CFG) & T153_WDT_RESET_MASK) !=
+	    T153_WDT_SYSTEM_RESET)
+		return -EIO;
+	return 0;
+}
+
+/* Returns only if register access or the watchdog reset failed. */
+static int t153_restart(int fel)
+{
+	void __iomem *wdt = (void __iomem *)T153_WDT_BASE;
+	unsigned int elapsed;
+	int ret, interrupts_enabled;
+	u32 value;
+
+	if (!fel) {
+		ret = t153_clear_fel_request();
+		if (ret)
+			return ret;
+	}
+	ret = t153_watchdog_prepare();
+	if (ret)
+		return ret;
+	if (fel) {
+		ret = t153_rtc_store(T153_FEL_MAGIC);
+		if (ret) {
+			t153_clear_fel_request();
+			return ret;
+		}
+	}
+
+	interrupts_enabled = disable_interrupts();
+	/* Interval zero is the SDK's shortest watchdog interval (0.5 s). */
+	value = readl(wdt + T153_WDT_MODE) & ~T153_WDT_TIMEOUT_MASK;
+	writel(value | T153_WDT_ENABLE | T153_WDT_KEY, wdt + T153_WDT_MODE);
+	writel(T153_WDT_RELOAD, wdt + T153_WDT_CTRL);
+	dsb();
+	isb();
+	ret = -EIO;
+	if ((readl(wdt + T153_WDT_MODE) &
+	     (T153_WDT_TIMEOUT_MASK | T153_WDT_ENABLE)) == T153_WDT_ENABLE) {
+		/* No watchdog servicing: let hardware reset. A bounded wait keeps
+		 * an unvalidated reset path recoverable at the efex command.
+		 */
+		for (elapsed = 0; elapsed < 2000; elapsed++)
+			udelay(1000);
+		ret = -ETIMEDOUT;
+	}
+	writel(T153_WDT_KEY, wdt + T153_WDT_MODE);
+	dsb();
+	if (fel && t153_clear_fel_request())
+		puts("Failed to clear RTC FEL request after reset failure\n");
+	if (interrupts_enabled)
+		enable_interrupts();
+	return ret;
+}
+
+void reset_cpu(void)
+{
+	int ret;
+
+	flush();
+	ret = t153_restart(0);
+	printf("T153 watchdog reset failed: %d\n", ret);
+	flush();
+	hang();
+}
+
+#ifndef CONFIG_XPL_BUILD
+static int do_t153_efex(struct cmd_tbl *cmdtp, int flag, int argc,
+		       char *const argv[])
+{
+	int ret;
+
+	if (argc != 1)
+		return CMD_RET_USAGE;
+	puts("T153: requesting BootROM FEL via watchdog reset\n");
+	flush();
+	ret = t153_restart(1);
+	printf("T153 FEL reset failed: %d\n", ret);
+	return CMD_RET_FAILURE;
+}
+
+U_BOOT_CMD(
+	efex, 1, 0, do_t153_efex,
+	"restart T153 into BootROM USB FEL mode",
+	""
+);
+#endif
diff --git a/package/boot/uboot-t153/files/board/dshanpi/t153/smp-dt.c b/package/boot/uboot-t153/files/board/dshanpi/t153/smp-dt.c
new file mode 100644
--- /dev/null
+++ b/package/boot/uboot-t153/files/board/dshanpi/t153/smp-dt.c
@@ -0,0 +1,95 @@
+// SPDX-License-Identifier: GPL-2.0+
+/* Final board fixup runs after arch_fixup_fdt() and its generic fdt_psci(). */
+#ifdef T153_SMP_DT_HOST_TEST
+#include <libfdt.h>
+#include <stdint.h>
+#include <stdio.h>
+#include <string.h>
+#define CONFIG_ARMV7_SECURE_BASE 0x50000
+#define CONFIG_ARMV7_SECURE_MAX_SIZE 0x8000
+#define ARM_PSCI_FN_CPU_ON 0x95c1ba60
+#else
+#include <config.h>
+#include <linux/libfdt.h>
+#include <asm/psci.h>
+#include <stdio.h>
+#include <string.h>
+#endif
+
+int t153_smp_fixup_dt(void *fdt)
+{
+	int node, cpus, ret, length, i;
+	unsigned int seen = 0;
+	const fdt32_t *reg;
+	const char *type;
+	uint64_t start, size;
+
+	/* Replace the complete node: appending arm,psci would accidentally
+	 * leave the input DTS's arm,psci-1.0 first in the compatible list.
+	 */
+	node = fdt_path_offset(fdt, "/psci");
+	if (node >= 0) {
+		ret = fdt_del_node(fdt, node);
+		if (ret)
+			return ret;
+	}
+	node = fdt_add_subnode(fdt, 0, "psci");
+	if (node < 0)
+		return node;
+	ret = fdt_setprop_string(fdt, node, "compatible", "arm,psci");
+	if (ret)
+		return ret;
+	ret = fdt_setprop_string(fdt, node, "method", "smc");
+	if (ret)
+		return ret;
+	ret = fdt_setprop_u32(fdt, node, "cpu_on", ARM_PSCI_FN_CPU_ON);
+	if (ret)
+		return ret;
+	ret = fdt_setprop_string(fdt, node, "status", "okay");
+	if (ret)
+		return ret;
+	cpus = fdt_path_offset(fdt, "/cpus");
+	if (cpus < 0)
+		return cpus;
+	fdt_for_each_subnode(node, fdt, cpus) {
+		type = fdt_getprop(fdt, node, "device_type", &length);
+		if (!type || length != 4 || memcmp(type, "cpu", 4))
+			continue;
+		reg = fdt_getprop(fdt, node, "reg", &length);
+		if (!reg || length != 4 || fdt32_to_cpu(*reg) > 3)
+			return -FDT_ERR_BADVALUE;
+		i = fdt32_to_cpu(*reg);
+		if (seen & (1U << i))
+			return -FDT_ERR_BADVALUE;
+		seen |= 1U << i;
+		ret = fdt_setprop_string(fdt, node, "status", "okay");
+		if (ret)
+			return ret;
+		ret = fdt_setprop_string(fdt, node, "enable-method", "psci");
+		if (ret)
+			return ret;
+	}
+	if (seen != 15)
+		return -FDT_ERR_BADVALUE;
+
+	/* SRAM is outside the Linux DRAM bank. Reserve it explicitly as well
+	 * so this resident firmware remains visible in the handoff contract.
+	 * This does not claim hardware TrustZone memory isolation.
+	 */
+	for (i = 0; i < fdt_num_mem_rsv(fdt); i++) {
+		ret = fdt_get_mem_rsv(fdt, i, &start, &size);
+		if (ret)
+			return ret;
+		if (start == CONFIG_ARMV7_SECURE_BASE &&
+		    size == CONFIG_ARMV7_SECURE_MAX_SIZE)
+			break;
+	}
+	if (i == fdt_num_mem_rsv(fdt)) {
+		ret = fdt_add_mem_rsv(fdt, CONFIG_ARMV7_SECURE_BASE,
+				      CONFIG_ARMV7_SECURE_MAX_SIZE);
+		if (ret)
+			return ret;
+	}
+	puts("Source boot: 4 Cortex-A7 CPUs; PSCI 0.1 CPU_ON; SRAM 0x50000..0x57fff.\n");
+	return 0;
+}
diff --git a/package/boot/uboot-t153/files/board/dshanpi/t153/spl.c b/package/boot/uboot-t153/files/board/dshanpi/t153/spl.c
new file mode 100644
--- /dev/null
+++ b/package/boot/uboot-t153/files/board/dshanpi/t153/spl.c
@@ -0,0 +1,73 @@
+// SPDX-License-Identifier: GPL-2.0+
+/* Source-only T153 SPL. SRAM execution until DDR training has succeeded. */
+#include <config.h>
+#include <cpu_func.h>
+#include <hang.h>
+#include <init.h>
+#include <spl.h>
+#include <sunxi_image.h>
+#include <asm/global_data.h>
+#include <asm/io.h>
+#include <linux/errno.h>
+#include "ddr.h"
+
+DECLARE_GLOBAL_DATA_PTR;
+
+/* Must be initialized data: saved by assembly before the BSS is cleared. */
+u32 t153_fel_context[5] __section(".data") = { 0, 0, 0, 0, 0 };
+extern void t153_return_to_fel(void) __attribute__((noreturn));
+extern void t153_handle_fel_request(void);
+
+void board_init_f(ulong dummy)
+{
+	int ret;
+	u32 frequency = 24000000;
+
+	board_early_init_f();
+	/* ARM generic counter control, using the board's 24 MHz oscillator. */
+	setbits_le32((void *)0x08120000, 1);
+	asm volatile("mcr p15, 0, %0, c14, c0, 0" : : "r" (frequency));
+	timer_init();
+	ret = spl_early_init();
+	if (ret)
+		hang();
+	preloader_console_init();
+	puts("T153 source SPL: no vendor DDR library\n");
+	t153_handle_fel_request();
+	ret = t153_ddr_init();
+	if (ret) {
+		printf("DDR failed (%d); stopping in SRAM\n", ret);
+		hang();
+	}
+	gd->ram_size = T153_DDR_SIZE_BYTES;
+}
+
+u32 spl_boot_device(void)
+{
+	struct boot_file_head *head = (void *)0x40000;
+
+	if (memcmp(head->magic, BOOT0_MAGIC, 8))
+		return BOOT_DEVICE_BOARD;
+	/* Only the standard 8 KiB card location is supported in this image. */
+	switch (readb(&head->boot_media)) {
+	case 0: return BOOT_DEVICE_MMC1;
+	case 2: return BOOT_DEVICE_MMC2;
+	default:
+		printf("SPL boot medium %u unsupported\n", readb(&head->boot_media));
+		hang();
+	}
+}
+
+u32 spl_mmc_boot_mode(struct mmc *mmc, const u32 boot_device)
+{
+	return MMCSD_MODE_RAW;
+}
+
+static int load_fel(struct spl_image_info *image, struct spl_boot_device *device)
+{
+	printf("DDR ready; returning to FEL (sp=%08x lr=%08x)\n",
+	       t153_fel_context[0], t153_fel_context[1]);
+	icache_disable();
+	t153_return_to_fel();
+}
+SPL_LOAD_IMAGE_METHOD("FEL", 0, BOOT_DEVICE_BOARD, load_fel);
diff --git a/package/boot/uboot-t153/files/board/dshanpi/t153/sunxi_mmc.h b/package/boot/uboot-t153/files/board/dshanpi/t153/sunxi_mmc.h
new file mode 100644
--- /dev/null
+++ b/package/boot/uboot-t153/files/board/dshanpi/t153/sunxi_mmc.h
@@ -0,0 +1,150 @@
+/* SPDX-License-Identifier: GPL-2.0+ */
+/*
+ * (C) Copyright 2007-2011
+ * Allwinner Technology Co., Ltd. <www.allwinnertech.com>
+ * Aaron <leafy.myeh@allwinnertech.com>
+ *
+ * MMC register definition for allwinner sunxi platform.
+ */
+
+#ifndef _SUNXI_MMC_H
+#define _SUNXI_MMC_H
+
+#include <linux/types.h>
+
+struct sunxi_mmc {
+	u32 gctrl;		/* 0x00 global control */
+	u32 clkcr;		/* 0x04 clock control */
+	u32 timeout;		/* 0x08 time out */
+	u32 width;		/* 0x0c bus width */
+	u32 blksz;		/* 0x10 block size */
+	u32 bytecnt;		/* 0x14 byte count */
+	u32 cmd;		/* 0x18 command */
+	u32 arg;		/* 0x1c argument */
+	u32 resp0;		/* 0x20 response 0 */
+	u32 resp1;		/* 0x24 response 1 */
+	u32 resp2;		/* 0x28 response 2 */
+	u32 resp3;		/* 0x2c response 3 */
+	u32 imask;		/* 0x30 interrupt mask */
+	u32 mint;		/* 0x34 masked interrupt status */
+	u32 rint;		/* 0x38 raw interrupt status */
+	u32 status;		/* 0x3c status */
+	u32 ftrglevel;		/* 0x40 FIFO threshold watermark*/
+	u32 funcsel;		/* 0x44 function select */
+	u32 cbcr;		/* 0x48 CIU byte count */
+	u32 bbcr;		/* 0x4c BIU byte count */
+	u32 dbgc;		/* 0x50 debug enable */
+	u32 res0;		/* 0x54 reserved */
+	u32 a12a;		/* 0x58 Auto command 12 argument */
+	u32 ntsr;		/* 0x5c	New timing set register */
+	u32 res1[6];
+	u32 hwrst;		/* 0x78 Hardware Reset */
+	u32 res5;
+	u32 dmac;		/* 0x80 internal DMA control */
+	u32 dlba;		/* 0x84 internal DMA descr list base address */
+	u32 idst;		/* 0x88 internal DMA status */
+	u32 idie;		/* 0x8c internal DMA interrupt enable */
+	u32 chda;		/* 0x90 */
+	u32 cbda;		/* 0x94 */
+	u32 res2[26];
+	u32 thldc;		/* 0x100 Threshold control */
+	u32 res3[16];
+	u32 samp_dl;
+	u32 res4[46];
+	u32 fifo;		/* 0x100 / 0x200 FIFO access address */
+};
+
+#define SUNXI_MMC_CLK_POWERSAVE		(0x1 << 17)
+#define SUNXI_MMC_CLK_ENABLE		(0x1 << 16)
+#define SUNXI_MMC_CLK_DIVIDER_MASK	(0xff)
+
+#define SUNXI_MMC_GCTRL		0x000
+#define SUNXI_MMC_GCTRL_SOFT_RESET	(0x1 << 0)
+#define SUNXI_MMC_GCTRL_FIFO_RESET	(0x1 << 1)
+#define SUNXI_MMC_GCTRL_DMA_RESET	(0x1 << 2)
+#define SUNXI_MMC_GCTRL_RESET		(SUNXI_MMC_GCTRL_SOFT_RESET|\
+					 SUNXI_MMC_GCTRL_FIFO_RESET|\
+					 SUNXI_MMC_GCTRL_DMA_RESET)
+#define SUNXI_MMC_GCTRL_DMA_ENABLE	(0x1 << 5)
+#define SUNXI_MMC_GCTRL_ACCESS_BY_AHB   (0x1 << 31)
+
+#define SUNXI_MMC_CMD_RESP_EXPIRE	(0x1 << 6)
+#define SUNXI_MMC_CMD_LONG_RESPONSE	(0x1 << 7)
+#define SUNXI_MMC_CMD_CHK_RESPONSE_CRC	(0x1 << 8)
+#define SUNXI_MMC_CMD_DATA_EXPIRE	(0x1 << 9)
+#define SUNXI_MMC_CMD_WRITE		(0x1 << 10)
+#define SUNXI_MMC_CMD_AUTO_STOP		(0x1 << 12)
+#define SUNXI_MMC_CMD_WAIT_PRE_OVER	(0x1 << 13)
+#define SUNXI_MMC_CMD_SEND_INIT_SEQ	(0x1 << 15)
+#define SUNXI_MMC_CMD_UPCLK_ONLY	(0x1 << 21)
+#define SUNXI_MMC_CMD_START		(0x1 << 31)
+
+#define SUNXI_MMC_RINT_RESP_ERROR		(0x1 << 1)
+#define SUNXI_MMC_RINT_COMMAND_DONE		(0x1 << 2)
+#define SUNXI_MMC_RINT_DATA_OVER		(0x1 << 3)
+#define SUNXI_MMC_RINT_TX_DATA_REQUEST		(0x1 << 4)
+#define SUNXI_MMC_RINT_RX_DATA_REQUEST		(0x1 << 5)
+#define SUNXI_MMC_RINT_RESP_CRC_ERROR		(0x1 << 6)
+#define SUNXI_MMC_RINT_DATA_CRC_ERROR		(0x1 << 7)
+#define SUNXI_MMC_RINT_RESP_TIMEOUT		(0x1 << 8)
+#define SUNXI_MMC_RINT_DATA_TIMEOUT		(0x1 << 9)
+#define SUNXI_MMC_RINT_VOLTAGE_CHANGE_DONE	(0x1 << 10)
+#define SUNXI_MMC_RINT_FIFO_RUN_ERROR		(0x1 << 11)
+#define SUNXI_MMC_RINT_HARD_WARE_LOCKED		(0x1 << 12)
+#define SUNXI_MMC_RINT_START_BIT_ERROR		(0x1 << 13)
+#define SUNXI_MMC_RINT_AUTO_COMMAND_DONE	(0x1 << 14)
+#define SUNXI_MMC_RINT_END_BIT_ERROR		(0x1 << 15)
+#define SUNXI_MMC_RINT_SDIO_INTERRUPT		(0x1 << 16)
+#define SUNXI_MMC_RINT_CARD_INSERT		(0x1 << 30)
+#define SUNXI_MMC_RINT_CARD_REMOVE		(0x1 << 31)
+#define SUNXI_MMC_RINT_INTERRUPT_ERROR_BIT      \
+	(SUNXI_MMC_RINT_RESP_ERROR |		\
+	 SUNXI_MMC_RINT_RESP_CRC_ERROR |	\
+	 SUNXI_MMC_RINT_DATA_CRC_ERROR |	\
+	 SUNXI_MMC_RINT_RESP_TIMEOUT |		\
+	 SUNXI_MMC_RINT_DATA_TIMEOUT |		\
+	 SUNXI_MMC_RINT_VOLTAGE_CHANGE_DONE |	\
+	 SUNXI_MMC_RINT_FIFO_RUN_ERROR |	\
+	 SUNXI_MMC_RINT_HARD_WARE_LOCKED |	\
+	 SUNXI_MMC_RINT_START_BIT_ERROR |	\
+	 SUNXI_MMC_RINT_END_BIT_ERROR) /* 0xbfc2 */
+#define SUNXI_MMC_RINT_INTERRUPT_DONE_BIT	\
+	(SUNXI_MMC_RINT_AUTO_COMMAND_DONE |	\
+	 SUNXI_MMC_RINT_DATA_OVER |		\
+	 SUNXI_MMC_RINT_COMMAND_DONE |		\
+	 SUNXI_MMC_RINT_VOLTAGE_CHANGE_DONE)
+
+#define SUNXI_MMC_STATUS_RXWL_FLAG		(0x1 << 0)
+#define SUNXI_MMC_STATUS_TXWL_FLAG		(0x1 << 1)
+#define SUNXI_MMC_STATUS_FIFO_EMPTY		(0x1 << 2)
+#define SUNXI_MMC_STATUS_FIFO_FULL		(0x1 << 3)
+#define SUNXI_MMC_STATUS_CARD_PRESENT		(0x1 << 8)
+#define SUNXI_MMC_STATUS_CARD_DATA_BUSY		(0x1 << 9)
+#define SUNXI_MMC_STATUS_DATA_FSM_BUSY		(0x1 << 10)
+#define SUNXI_MMC_STATUS_FIFO_LEVEL(reg)	(((reg) >> 17) & 0x3fff)
+
+#define SUNXI_MMC_NTSR_MODE_SEL_NEW		(0x1 << 31)
+
+#define SUNXI_MMC_HWRST		0x078
+#define SUNXI_MMC_HWRST_ASSERT		(0x0 << 0)
+#define SUNXI_MMC_HWRST_DEASSERT	(0x1 << 0)
+
+#define SUNXI_MMC_IDMAC_RESET		(0x1 << 0)
+#define SUNXI_MMC_IDMAC_FIXBURST	(0x1 << 1)
+#define SUNXI_MMC_IDMAC_ENABLE		(0x1 << 7)
+
+#define SUNXI_MMC_IDIE_TXIRQ		(0x1 << 0)
+#define SUNXI_MMC_IDIE_RXIRQ		(0x1 << 1)
+
+#define SUNXI_MMC_COMMON_CLK_GATE		(1 << 16)
+#define SUNXI_MMC_COMMON_RESET			(1 << 18)
+
+#define SUNXI_MMC_THLDC		0x100
+#define SUNXI_MMC_THLDC_READ_EN		(0x1 << 0)
+#define SUNXI_MMC_THLDC_BSY_CLR_INT_EN	(0x1 << 1)
+#define SUNXI_MMC_THLDC_WRITE_EN	(0x1 << 2)
+#define SUNXI_MMC_THLDC_READ_THLD(x)	(((x) & 0xfff) << 16)
+
+#define SUNXI_MMC_CAL_DL_SW_EN		(0x1 << 7)
+
+#endif /* _SUNXI_MMC_H */
