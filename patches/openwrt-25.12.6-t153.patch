+++ b/package/boot/uboot-t153/files/arch/arm/dts/sun8i-t153-dshanpi-omnigate-uboot.dts
@@ -0,0 +1,43 @@
+// SPDX-License-Identifier: (GPL-2.0+ OR MIT)
+/dts-v1/;
+
+/ {
+	model = "DshanPI T153MX OmniGate RAM U-Boot";
+	compatible = "dshanpi,t153mx-omnigate", "allwinner,sun8i-t153";
+	#address-cells = <1>;
+	#size-cells = <1>;
+	aliases {
+		serial0 = &uart0;
+		mmc0 = &mmc0;
+		mmc1 = &mmc2;
+	};
+	chosen { stdout-path = "serial0:115200n8"; };
+	memory@48000000 {
+		device_type = "memory";
+		reg = <0x48000000 0x18000000>;
+	};
+	uart0: serial@2600000 {
+		compatible = "snps,dw-apb-uart";
+		reg = <0x02600000 0x400>;
+		reg-shift = <2>;
+		reg-io-width = <4>;
+		clock-frequency = <24000000>;
+		bootph-all;
+	};
+	mmc0: mmc@4020000 {
+		compatible = "dshanpi,t153-ram-mmc";
+		bootph-all;
+		reg = <0x04020000 0x1000>;
+		bus-width = <4>;
+		max-frequency = <12000000>;
+		broken-cd;
+	};
+	mmc2: mmc@4022000 {
+		compatible = "dshanpi,t153-ram-mmc";
+		bootph-all;
+		reg = <0x04022000 0x1000>;
+		bus-width = <8>;
+		max-frequency = <12000000>;
+		non-removable;
+	};
+};
diff --git a/package/boot/uboot-t153/files/board/dshanpi/t153/Kconfig b/package/boot/uboot-t153/files/board/dshanpi/t153/Kconfig
new file mode 100644
--- /dev/null
+++ b/package/boot/uboot-t153/files/board/dshanpi/t153/Kconfig
@@ -0,0 +1,35 @@
+if TARGET_DSHANPI_T153_RAM || TARGET_DSHANPI_T153_SOURCE
+
+config SYS_BOARD
+	default "t153"
+
+config SYS_VENDOR
+	default "dshanpi"
+
+config SYS_CONFIG_NAME
+	default "dshanpi_t153_ram"
+
+config T153_DDR_SIZE_MIB
+	int "Physical T153 DDR4 capacity in MiB"
+	depends on TARGET_DSHANPI_T153_SOURCE
+	default 512
+	range 512 1024
+	help
+	  Fixed single-rank x16 geometry. Only 512 (15 rows) and 1024
+	  (16 rows) are implemented. Usable U-Boot/Linux RAM remains capped
+	  at 384 MiB in both bring-up profiles. This is not a size probe.
+
+config T153_PSCI_COLD_SMP
+	bool "Experimental T153 four-core cold boot via PSCI 0.1"
+	depends on TARGET_DSHANPI_T153_SOURCE && T153_DDR_SIZE_MIB = 1024
+	select CPU_V7_HAS_NONSEC
+	select ARCH_SUPPORT_PSCI
+	select ARMV7_SET_CORTEX_SMPEN
+	select HAS_ARMV7_SECURE_BASE
+	help
+	  Source CPU_ON backend for the four Cortex-A7 cores. The monitor
+	  remains in SRAM C; no factory monitor is linked. CPU_OFF,
+	  CPU_SUSPEND, hotplug and multi-core kexec are not implemented.
+	  This is an opt-in bring-up profile; CPU0 default is unchanged.
+
+endif
