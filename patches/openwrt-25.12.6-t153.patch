+# SPDX-License-Identifier: (GPL-2.0-only OR BSD-2-Clause)
+%YAML 1.2
+---
+$id: http://devicetree.org/schemas/net/allwinner,sun8i-t153-dwmac.yaml#
+$schema: http://devicetree.org/meta-schemas/core.yaml#
+
+title: Allwinner T153 GMAC-211
+
+maintainers:
+  - Chen-Yu Tsai <wens@csie.org>
+  - Maxime Ripard <mripard@kernel.org>
+
+allOf:
+  - $ref: snps,dwmac.yaml#
+
+properties:
+  compatible:
+    const: allwinner,sun8i-t153-dwmac
+  reg:
+    items:
+      - description: DWMAC controller registers
+      - description: RGMII clock and delay configuration registers
+  interrupts:
+    maxItems: 1
+  interrupt-names:
+    const: macirq
+  clocks:
+    maxItems: 6
+  clock-names:
+    items:
+      - const: stmmaceth
+      - const: pclk
+      - const: ptp_ref
+      - const: phy
+      - const: ahb-sw
+      - const: mbus-sw
+  resets:
+    maxItems: 2
+  reset-names:
+    items:
+      - const: stmmaceth
+      - const: ahb
+  allwinner,tx-delay-taps:
+    $ref: /schemas/types.yaml#/definitions/uint32
+    description: RGMII transmit delay-chain taps from board signal qualification.
+    maximum: 31
+  allwinner,rx-delay-taps:
+    $ref: /schemas/types.yaml#/definitions/uint32
+    description: RGMII receive delay-chain taps from board signal qualification.
+    maximum: 31
+  allwinner,external-rgmii-clock:
+    type: boolean
+    description: Select the external RGMII transmit clock source.
+  allwinner,provide-phy-clock:
+    type: boolean
+    description: Enable the CCU clock output used as the external PHY reference.
+
+required:
+  - compatible
+  - reg
+  - interrupts
+  - interrupt-names
+  - clocks
+  - clock-names
+  - resets
+  - reset-names
+  - phy-mode
+  - phy-handle
+
+unevaluatedProperties: false
diff --git a/target/linux/sunxi/files/Documentation/devicetree/bindings/net/can/allwinner,sun8i-t153-can.yaml b/target/linux/sunxi/files/Documentation/devicetree/bindings/net/can/allwinner,sun8i-t153-can.yaml
new file mode 100644
--- /dev/null
+++ b/target/linux/sunxi/files/Documentation/devicetree/bindings/net/can/allwinner,sun8i-t153-can.yaml
@@ -0,0 +1,115 @@
+# SPDX-License-Identifier: (GPL-2.0-only OR BSD-2-Clause)
+%YAML 1.2
+---
+$id: http://devicetree.org/schemas/net/can/allwinner,sun8i-t153-can.yaml#
+$schema: http://devicetree.org/meta-schemas/core.yaml#
+
+title: Allwinner T153 CAN-FD controller
+
+maintainers:
+  - Chen-Yu Tsai <wens@csie.org>
+  - Maxime Ripard <mripard@kernel.org>
+
+allOf:
+  - $ref: can-controller.yaml#
+
+properties:
+  compatible:
+    const: allwinner,sun8i-t153-can
+  reg:
+    items:
+      - description: Bosch M_CAN core registers
+      - description: Private message RAM
+      - description: Allwinner CAN top control registers
+  reg-names:
+    items:
+      - const: m_can
+      - const: message_ram
+      - const: top
+  interrupts:
+    maxItems: 1
+  interrupt-names:
+    const: int0
+  clocks:
+    maxItems: 3
+  clock-names:
+    items:
+      - const: hclk
+      - const: cclk
+      - const: mbus
+  resets:
+    maxItems: 2
+  reset-names:
+    items:
+      - const: core
+      - const: sys
+  bosch,mram-cfg:
+    description: |
+      Message RAM configuration data.
+      Multiple M_CAN instances can share the same Message RAM
+      and each element(e.g Rx FIFO or Tx Buffer and etc) number
+      in Message RAM is also configurable, so this property is
+      telling driver how the shared or private Message RAM are
+      used by this M_CAN controller.
+
+      The format should be as follows:
+      <offset sidf_elems xidf_elems rxf0_elems rxf1_elems rxb_elems txe_elems txb_elems>
+      The 'offset' is an address offset of the Message RAM where
+      the following elements start from. This is usually set to
+      0x0 if you're using a private Message RAM. The remain cells
+      are used to specify how many elements are used for each FIFO/Buffer.
+
+      M_CAN includes the following elements according to user manual:
+      11-bit Filter	0-128 elements / 0-128 words
+      29-bit Filter	0-64 elements / 0-128 words
+      Rx FIFO 0		0-64 elements / 0-1152 words
+      Rx FIFO 1		0-64 elements / 0-1152 words
+      Rx Buffers	0-64 elements / 0-1152 words
+      Tx Event FIFO	0-32 elements / 0-64 words
+      Tx Buffers	0-32 elements / 0-576 words
+
+      Please refer to 2.4.1 Message RAM Configuration in Bosch
+      M_CAN user manual for details.
+    $ref: /schemas/types.yaml#/definitions/int32-array
+    items:
+      - description: The 'offset' is an address offset of the Message RAM where
+          the following elements start from. This is usually set to 0x0 if
+          you're using a private Message RAM.
+        default: 0
+      - description: 11-bit Filter 0-128 elements / 0-128 words
+        minimum: 0
+        maximum: 128
+      - description: 29-bit Filter 0-64 elements / 0-128 words
+        minimum: 0
+        maximum: 64
+      - description: Rx FIFO 0 0-64 elements / 0-1152 words
+        minimum: 0
+        maximum: 64
+      - description: Rx FIFO 1 0-64 elements / 0-1152 words
+        minimum: 0
+        maximum: 64
+      - description: Rx Buffers 0-64 elements / 0-1152 words
+        minimum: 0
+        maximum: 64
+      - description: Tx Event FIFO 0-32 elements / 0-64 words
+        minimum: 0
+        maximum: 32
+      - description: Tx Buffers 0-32 elements / 0-576 words
+        minimum: 0
+        maximum: 32
+    minItems: 8
+
+
+required:
+  - compatible
+  - reg
+  - reg-names
+  - interrupts
+  - interrupt-names
+  - clocks
+  - clock-names
+  - resets
+  - reset-names
+  - bosch,mram-cfg
+
+unevaluatedProperties: false
